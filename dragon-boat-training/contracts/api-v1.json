{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_version": "2026-09-02.p2.1",
  "service": "dragon-boat-training",
  "extensions": {
    "current_view": {
      "since_service_version": "0.5.0-p2.1",
      "compatibility": "Additive opt-in extension; contract version unchanged. Older clients receive the original result. New clients fall back to reads if the optional view is absent.",
      "actions": ["signup", "updateSignup", "cancelSignup", "signupByCoach", "updateSignupByCoach", "cancelSignupByCoach", "updateMember", "restoreMemberName", "setMemberStatus"],
      "optional_request_fields": ["include_current_view", "known_roster_version", "roster_expires_at", "view_practice_id"],
      "response": "include_current_view=true adds view_status=ready|refresh_required and current_view. Original mutation result remains immutable; current_view is rebuilt after commit or replay under the same lock and is never stored in the journal. Projection failure returns a successful mutation with refresh_required and null view.",
      "current_view_fields": ["season_id", "season_status", "roster_version", "binding_version", "generated_at", "optional practice", "optional roster", "management-only optional members", "management-only member_links"],
      "practice": "Same projection as GET practice, including generated_at. Used to render present state rather than the historical mutation result.",
      "roster": "Public roster returned when known_roster_version differs or roster_expires_at has expired. Cache hints never authorize a write. Browser validates season, binding and roster versions and absolute expiry.",
      "management": "Full protected members returned only when roster version differs; current member_links always returned. view_practice_id scopes member-edit readback, cannot change the mutation target.",
      "retry": "View preferences are excluded from the business payload digest. Unknown writes keep the original request ID and payload. An acknowledged write needing a view retries reads only. Late or wrong-entity views never replace newer visible data."
    }
  },
  "transport": {
    "get_action_parameter": "action",
    "post_content_type": "text/plain;charset=UTF-8",
    "post_body": "JSON object",
    "redirect": "follow",
    "management_transport": "POST body only; session_token is never placed in a URL"
  },
  "request": {
    "request_id": "8 to 128 ASCII letters, numbers, underscores or hyphens",
    "action": "required action name"
  },
  "response": {
    "success": {
      "ok": true,
      "data": "action-specific object",
      "meta": {
        "contract_version": "2026-09-02.p2.1",
        "server_time": "ISO 8601 timestamp",
        "request_id": "request identifier"
      }
    },
    "failure": {
      "ok": false,
      "error": {
        "code": "stable error code",
        "message": "safe user-facing message",
        "retryable": "boolean"
      },
      "meta": {
        "contract_version": "2026-09-02.p2.1",
        "server_time": "ISO 8601 timestamp",
        "request_id": "request identifier"
      }
    }
  },
  "actions": {
    "getMemberWorkspace": {
      "methods": ["POST"], "authentication": "session_token", "writes_data": false,
      "request_fields": ["session_token", "season_id", "optional practice_id", "optional known_roster_version"],
      "response_fields": ["season", "practices", "season_id", "season_status", "roster_version", "binding_version", "generated_at", "optional practice", "optional members", "member_links"],
      "notes": "Reads an open season management workspace under one lock. Published practices only; chooses the first if practice_id is omitted. Returns full members if version differs. VIEW_UNAVAILABLE is a retryable read failure, never evidence of a failed prior mutation."
    },
    "practice": {
      "methods": ["GET"], "authentication": "public", "writes_data": false,
      "request_fields": ["season_id", "practice_id"],
      "response_fields": ["season_id", "practice", "signup_version", "roster_version", "binding_version", "signup_open", "management_signup_open", "closed_reason", "counts", "signups", "generated_at"],
      "notes": "Requires both a published practice and an opened week. Reads the latest signup state, never a ten-minute training cache. Cancelled rows are excluded. Confirmed and waitlisted rows carry member_id, display_name, preference, status, queue_at, queue_sequence and waitlist_position."
    },
    "signup": {
      "methods": ["POST"], "authentication": "public", "writes_data": true,
      "request_fields": ["season_id", "practice_id", "member_id", "practice_version", "signup_version", "preference"],
      "response_fields": ["season_id", "practice_id", "signup_version", "signup", "promoted_member_ids"],
      "notes": "Creates or reactivates a cancelled signup with a new queue timestamp and sequence. Public identity is selected, not authenticated."
    },
    "updateSignup": {
      "methods": ["POST"], "authentication": "public", "writes_data": true,
      "request_fields": ["season_id", "practice_id", "member_id", "practice_version", "signup_version", "preference"],
      "response_fields": ["season_id", "practice_id", "signup_version", "signup", "promoted_member_ids"],
      "notes": "Preserves the existing queue timestamp and sequence; identical preference is a no-op. Target-side capacity can produce WAITLISTED as a successful result."
    },
    "cancelSignup": {
      "methods": ["POST"], "authentication": "public", "writes_data": true,
      "request_fields": ["season_id", "practice_id", "member_id", "practice_version", "signup_version"],
      "response_fields": ["season_id", "practice_id", "signup_version", "signup", "promoted_member_ids"]
    },
    "signupByCoach": {
      "methods": ["POST"], "authentication": "session_token", "writes_data": true,
      "request_fields": ["session_token", "season_id", "practice_id", "member_id", "practice_version", "signup_version", "preference"],
      "response_fields": ["season_id", "practice_id", "signup_version", "signup", "promoted_member_ids"]
    },
    "updateSignupByCoach": {
      "methods": ["POST"], "authentication": "session_token", "writes_data": true,
      "request_fields": ["session_token", "season_id", "practice_id", "member_id", "practice_version", "signup_version", "preference"],
      "response_fields": ["season_id", "practice_id", "signup_version", "signup", "promoted_member_ids"]
    },
    "cancelSignupByCoach": {
      "methods": ["POST"], "authentication": "session_token", "writes_data": true,
      "request_fields": ["session_token", "season_id", "practice_id", "member_id", "practice_version", "signup_version"],
      "response_fields": ["season_id", "practice_id", "signup_version", "signup", "promoted_member_ids"]
    },
    "listSeasonMembers": {
      "methods": ["POST"], "authentication": "session_token", "writes_data": false,
      "request_fields": ["session_token", "season_id"],
      "response_fields": ["season_id", "roster_version", "members"],
      "notes": "Members include source_display_name, display_name_override, display_name, default_preference, status, member_version, and active_links. No raw responses or contact fields are returned."
    },
    "updateMember": {
      "methods": ["POST"], "authentication": "session_token", "writes_data": true,
      "request_fields": ["session_token", "season_id", "member_id", "member_version", "display_name_override", "default_preference"],
      "response_fields": ["season_id", "roster_version", "member"]
    },
    "restoreMemberName": {
      "methods": ["POST"], "authentication": "session_token", "writes_data": true,
      "request_fields": ["session_token", "season_id", "member_id", "member_version"],
      "response_fields": ["season_id", "roster_version", "member"]
    },
    "setMemberStatus": {
      "methods": ["POST"], "authentication": "session_token", "writes_data": true,
      "request_fields": ["session_token", "season_id", "member_id", "member_version", "status"],
      "response_fields": ["season_id", "roster_version", "member"],
      "notes": "ACTIVE or INACTIVE. Deactivation is rejected while unfinished training associations remain."
    },
    "health": {
      "methods": ["GET", "POST"],
      "authentication": "public",
      "writes_data": false
    },
    "bootstrap": {
      "methods": ["GET"],
      "authentication": "public",
      "request_fields": ["optional season_id"],
      "response_fields": ["state", "season", "weeks"],
      "writes_data": false,
      "notes": "Returns only published practices. Draft weeks and unpublished additional practices are excluded."
    },
    "members": {
      "methods": ["GET"],
      "authentication": "public",
      "request_fields": ["season_id"],
      "response_fields": ["season_id", "binding_version", "roster_version", "generated_at", "expires_at", "members"],
      "writes_data": false,
      "notes": "The shared server snapshot has one absolute ten-minute expiry and contains active public member fields only."
    },
    "coachLogin": {
      "methods": ["POST"],
      "authentication": "coach_code",
      "request_fields": ["coach_code"],
      "response_fields": ["session_token", "session.coach_id", "session.display_name", "session.issued_at", "session.expires_at"],
      "writes_data": true,
      "notes": "The plain Coach Code is validated but never stored in a sheet or response."
    },
    "coachBootstrap": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token"],
      "response_fields": ["coach", "session", "panels", "p0_connectivity_write_available", "default_season_id", "seasons"],
      "writes_data": false
    },
    "coachConnectivityWrite": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token"],
      "response_fields": ["write_id", "status"],
      "writes_data": true,
      "notes": "P0-only protected write. It appends one idempotent system audit event and does not change season, member, practice, signup or seat data."
    },
    "coachLogout": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token"],
      "response_fields": ["session_id", "revoked"],
      "writes_data": true
    },
    "getSeasonManagement": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token", "season_id"],
      "response_fields": ["season", "is_default", "templates", "weeks", "members"],
      "writes_data": false
    },
    "createSeason": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token", "name", "start_date", "end_date", "timezone"],
      "response_fields": ["season"],
      "writes_data": true
    },
    "validateSeasonBinding": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token", "season_id", "form", "spreadsheet", "response_sheet", "display_name_header"],
      "response_fields": ["form_id", "form_url", "runtime_spreadsheet_id", "response_sheet_id", "response_sheet_name", "display_name_header", "schema_fingerprint", "response_count", "preview_names"],
      "writes_data": false
    },
    "initializeSeason": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token", "season_id", "season_version", "form", "spreadsheet", "response_sheet", "display_name_header"],
      "response_fields": ["season", "sync", "default_season_id"],
      "writes_data": true,
      "notes": "Revalidates the binding, initializes runtime tabs and the form-submit trigger, imports members, locks the binding and automatically opens the season."
    },
    "retrySeasonSync": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token", "season_id"],
      "response_fields": ["season", "sync"],
      "writes_data": true
    },
    "updateScheduleTemplates": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token", "season_id", "season_version", "templates"],
      "response_fields": ["season", "templates"],
      "writes_data": true
    },
    "updateTrainingWeek": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token", "season_id", "season_version", "week_start_date"],
      "response_fields": ["week", "practices"],
      "writes_data": true,
      "notes": "Creates or recovers a private week draft from active templates."
    },
    "confirmTrainingWeek": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token", "season_id", "week_id", "week_version", "optional open_at"],
      "response_fields": ["week", "practices"],
      "writes_data": true
    },
    "publishTrainingWeek": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token", "season_id", "week_id", "week_version"],
      "response_fields": ["week", "practices"],
      "writes_data": true
    },
    "createPractice": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token", "season_id", "week_id", "week_version", "practice_date", "start_time", "end_time", "location", "address", "optional map_url"],
      "response_fields": ["week", "practice"],
      "writes_data": true,
      "notes": "Creates a private additional-practice draft in an already-open week."
    },
    "publishAdditionalPractice": {
      "methods": ["POST"],
      "authentication": "session_token",
      "request_fields": ["session_token", "season_id", "week_id", "practice_id", "week_version", "practice_version"],
      "response_fields": ["week", "practice"],
      "writes_data": true,
      "notes": "Publishes only the named additional practice."
    }
  },
  "management_errors": [
    "COACH_CODE_INVALID",
    "LOGIN_RATE_LIMITED",
    "SESSION_INVALID",
    "SESSION_EXPIRED",
    "SESSION_REVOKED",
    "IDEMPOTENCY_CONFLICT",
    "SERVICE_BUSY",
    "CONFIGURATION_REQUIRED",
    "CONFIGURATION_ERROR",
    "RECOVERY_REQUIRED",
    "VERSION_CONFLICT",
    "SEASON_NOT_FOUND",
    "SEASON_NOT_OPEN",
    "BINDING_LOCKED"
  ],
  "signup_errors": ["VERSION_CONFLICT", "PRACTICE_NOT_PUBLIC", "MEMBER_NOT_FOUND", "MEMBER_INACTIVE", "INVALID_PREFERENCE", "SIGNUP_EXISTS", "SIGNUP_NOT_ACTIVE", "SIGNUP_CLOSED", "PRACTICE_ENDED", "PRACTICE_CANCELLED", "SIGNUP_RATE_LIMITED", "SEAT_PLAN_REQUIRES_P3"],
  "member_errors": ["MEMBER_HAS_ACTIVE_LINKS", "MEMBER_NOT_FOUND", "VERSION_CONFLICT"],
  "p2_write_protocol": "POST timeout is 30 seconds. Freeze request_id and all business parameters while the result is unknown. Completed requests return the original result even after later state changes; GET practice afterwards for current state. Unfinished plans recover under the shared script lock before subsequent reads/writes."
}
