---
import logoUrl from "../../assets/team-logo-placeholder.svg";
import "../styles/app.css";
import "../styles/member-management.css";
import "../styles/signup.css";
import "../styles/seat-plan.css";
import "../styles/seat-plan-admin.css";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const appPath = `${basePath}dragon-boat-training/`;
const coachPath = `${appPath}coach/`;
const apiUrl = import.meta.env.PUBLIC_DRAGON_BOAT_API_URL
  || "https://script.google.com/macros/s/AKfycbw4c8mBbop9Qnq29nYQ_AtLembq1OHKt_nRjIv3EE9kw0DliTVM0lMY6svr8X0gcQW8/exec";
---

<div class="dragon-boat-app" data-coach-mode-app data-api-url={apiUrl}>
  <header class="dragon-boat-header dragon-boat-shell">
    <a class="dragon-boat-brand" href={appPath} aria-label="Dragon Boat Training 首页">
      <img src={logoUrl.src} alt="队伍 Logo 占位图" width="96" height="96" />
      <span class="dragon-boat-brand-copy">
        <span>Dragon Boat Training</span>
        <small>Team training portal</small>
      </span>
    </a>
    <nav class="dragon-boat-nav" aria-label="训练系统导航">
      <a href={appPath}>本季训练</a>
      <button type="button" disabled title="将在历史阶段实现">过往赛季</button>
      <a href={coachPath} aria-current="page">Coach Mode</a>
    </nav>
  </header>

  <main class="dragon-boat-main dragon-boat-shell dragon-boat-coach-main">
    <p class="dragon-boat-kicker">统一管理入口</p>
    <h1>Coach Mode</h1>
    <p class="dragon-boat-lede">
      Coach、Steerer 和其他管理员使用各自的 Coach Code 登录同一个工作区，拥有相同的管理能力。
    </p>

    <section class="dragon-boat-auth-card" data-login-panel aria-labelledby="coach-login-title">
      <div>
        <h2 id="coach-login-title">输入个人 Coach Code</h2>
        <p>Code 只用于本次登录，不会显示在页面上，也不会保存在浏览器中。</p>
      </div>
      <form class="dragon-boat-login-form" data-login-form>
        <label for="coach-code">Coach Code</label>
        <div class="dragon-boat-login-row">
          <input id="coach-code" name="coach_code" type="password" minlength="6" maxlength="128" autocomplete="off" spellcheck="false" required data-coach-code />
          <button type="submit" class="dragon-boat-primary-button" data-login-button>登录</button>
        </div>
      </form>
      <p class="dragon-boat-form-status" data-login-status aria-live="polite"></p>
    </section>

    <section class="dragon-boat-workspace" data-workspace hidden aria-labelledby="coach-workspace-title">
      <div class="dragon-boat-workspace-heading">
        <div>
          <p class="dragon-boat-session-label">当前管理会话</p>
          <h2 id="coach-workspace-title" data-coach-name>Coach Mode</h2>
          <p data-session-expiry></p>
        </div>
        <button type="button" class="dragon-boat-secondary-button" data-logout-button>退出</button>
      </div>

      <div class="dragon-boat-panel-grid" data-panel-grid></div>

      <section class="dragon-boat-management-console" aria-labelledby="season-management-title">
        <div class="dragon-boat-section-heading">
          <div>
            <p class="dragon-boat-session-label">赛季管理</p>
            <h3 id="season-management-title">赛季、名单与周训练</h3>
          </div>
          <button type="button" class="dragon-boat-secondary-button" data-refresh-button>刷新</button>
        </div>
        <p class="dragon-boat-form-status" data-management-status aria-live="polite"></p>
        <button type="button" class="dragon-boat-secondary-button" data-management-retry hidden>按原内容重试上次操作</button>

        <div class="dragon-boat-season-picker">
          <label for="season-picker">当前查看</label>
          <select id="season-picker" data-season-picker></select>
          <button type="button" class="dragon-boat-secondary-button" data-open-season>打开赛季与排期</button>
          <button type="button" class="dragon-boat-secondary-button" data-open-members>打开队员、报名与排座</button>
        </div>

        <details class="dragon-boat-management-block" data-create-season-details>
          <summary>建立新赛季草稿</summary>
          <form class="dragon-boat-form-grid" data-create-season-form>
            <label>赛季名称<input name="name" required maxlength="120" placeholder="例如 Fall 2026" /></label>
            <label>开始日期<input name="start_date" type="date" required /></label>
            <label>最后有效日<input name="end_date" type="date" required /></label>
            <label>时区<input name="timezone" required value="America/New_York" /></label>
            <button type="submit" class="dragon-boat-primary-button">保存草稿</button>
          </form>
        </details>

        <section class="dragon-boat-management-block" data-season-detail hidden>
          <div class="dragon-boat-section-heading">
            <div>
              <p class="dragon-boat-session-label" data-season-status></p>
              <h3 data-season-title></h3>
              <p data-season-meta></p>
            </div>
            <button type="button" class="dragon-boat-secondary-button" data-sync-button hidden>重新检查名单</button>
          </div>
          <p data-season-sync></p>
        </section>

        <section class="dragon-boat-management-block" data-binding-block hidden>
          <h3>连接 Google Form 与响应表</h3>
          <p>请先在 Google Forms 中把本季表单连接到响应 Spreadsheet，再粘贴 Form 编辑地址和 Spreadsheet 地址。系统不会替你改变 Form 的响应目标。</p>
          <form class="dragon-boat-form-grid" data-binding-form>
            <label class="dragon-boat-field-wide">Form 编辑地址或 ID<input name="form" required /></label>
            <label class="dragon-boat-field-wide">响应 Spreadsheet 地址或 ID<input name="spreadsheet" required /></label>
            <label>响应 Tab 名称<input name="response_sheet" required value="Form Responses 1" /></label>
            <label>姓名列标题<input name="display_name_header" required placeholder="Display Name" /></label>
            <div class="dragon-boat-button-row dragon-boat-field-wide">
              <button type="submit" class="dragon-boat-secondary-button">检查连接</button>
              <button type="button" class="dragon-boat-primary-button" data-initialize-button disabled>初始化并激活赛季</button>
            </div>
          </form>
          <p class="dragon-boat-form-status" data-binding-status aria-live="polite"></p>
        </section>

        <section class="dragon-boat-management-block" data-active-season-block hidden>
          <h3>默认训练模板</h3>
          <p>每周草稿从当前模板生成。保存模板不会公开训练。</p>
          <form data-template-form>
            <div data-template-rows></div>
            <div class="dragon-boat-button-row">
              <button type="button" class="dragon-boat-secondary-button" data-add-template-button>增加一条模板</button>
              <button type="submit" class="dragon-boat-primary-button">保存全部模板</button>
            </div>
          </form>

          <div class="dragon-boat-divider"></div>
          <h3>开放新一周</h3>
          <form class="dragon-boat-inline-form" data-week-form>
            <label>周一日期<input name="week_start_date" type="date" required /></label>
            <button type="submit" class="dragon-boat-secondary-button">生成私有周草稿</button>
          </form>
          <div data-admin-week-list></div>

          <div class="dragon-boat-divider"></div>
          <h3>为已开放周增加单次训练</h3>
          <form class="dragon-boat-form-grid" data-additional-form>
            <label>所属周<select name="week_id" required data-additional-week></select></label>
            <label>训练日期<input name="practice_date" type="date" required /></label>
            <label>开始时间<input name="start_time" type="time" required /></label>
            <label>结束时间<input name="end_time" type="time" required /></label>
            <label>地点<input name="location" required /></label>
            <label>完整地址<input name="address" required /></label>
            <label class="dragon-boat-field-wide">地图链接（可选）<input name="map_url" type="url" /></label>
            <button type="submit" class="dragon-boat-secondary-button">保存为私有加场草稿</button>
          </form>
        </section>
      </section>

      <section class="dragon-boat-management-console dragon-boat-member-console" data-member-console hidden aria-labelledby="member-management-title">
        <div class="dragon-boat-section-heading">
          <div>
            <p class="dragon-boat-session-label">队员与训练</p>
            <h3 id="member-management-title">队员及报名维护</h3>
          </div>
          <button type="button" class="dragon-boat-secondary-button" data-member-refresh>刷新名单与报名</button>
        </div>
        <p class="dragon-boat-form-status" data-member-console-status aria-live="polite"></p>

        <details class="dragon-boat-management-block" open>
          <summary>赛季队员名册</summary>
          <p>原始表单姓名保留不变。这里的修正姓名和默认偏好会用于之后的训练；修改默认偏好不会改动已有报名。</p>
          <div class="dragon-boat-member-layout">
            <div class="dragon-boat-member-search">
              <label for="managed-member-search">搜索姓名<input id="managed-member-search" type="search" autocomplete="off" data-member-search /></label>
              <label for="managed-member-picker">选择队员<select id="managed-member-picker" size="7" data-member-picker></select></label>
              <p data-member-count></p>
            </div>
            <div data-member-detail hidden>
              <dl class="dragon-boat-member-facts">
                <div><dt>表单原始姓名</dt><dd data-member-source></dd></div>
                <div><dt>当前显示姓名</dt><dd data-member-current-name></dd></div>
                <div><dt>状态及版本</dt><dd data-member-state></dd></div>
              </dl>
              <form data-member-edit-form>
                <fieldset class="dragon-boat-form-grid" data-member-edit-fields>
                  <label>修正姓名（留空则使用表单姓名）<input name="display_name_override" maxlength="120" autocomplete="off" /></label>
                  <label>默认侧向偏好<select name="default_preference"><option value="LEFT">Left · 左侧</option><option value="AMBIENT">Ambient · 左右均可</option><option value="RIGHT">Right · 右侧</option></select></label>
                  <p class="dragon-boat-field-wide dragon-boat-change-preview" data-member-preview></p>
                  <div class="dragon-boat-button-row dragon-boat-field-wide">
                    <button type="submit" class="dragon-boat-primary-button">保存队员资料</button>
                    <button type="button" class="dragon-boat-secondary-button" data-member-restore>恢复表单姓名</button>
                  </div>
                </fieldset>
              </form>
              <div class="dragon-boat-member-links" data-member-links></div>
              <div class="dragon-boat-member-status-action">
                <label class="dragon-boat-check-label"><input type="checkbox" data-member-status-confirm /><span data-member-status-explanation></span></label>
                <button type="button" class="dragon-boat-secondary-button" data-member-status-button></button>
              </div>
            </div>
          </div>
          <p class="dragon-boat-form-status" data-member-edit-status aria-live="polite"></p>
          <button type="button" class="dragon-boat-secondary-button" data-member-retry hidden>按原内容重试并确认结果</button>
        </details>

        <section class="dragon-boat-management-block" aria-labelledby="signup-management-title">
          <h3 id="signup-management-title">单次训练报名清单</h3>
          <p>管理员可以代报名、直接改偏好或取消报名。普通报名截止后仍可管理，训练结束后报名记录只读。</p>
          <div class="dragon-boat-inline-form">
            <label>选择已发布训练<select data-managed-practice-picker></select></label>
            <button type="button" class="dragon-boat-secondary-button" data-managed-practice-refresh>刷新这次训练</button>
          </div>
          <p class="dragon-boat-form-status" data-managed-practice-status aria-live="polite"></p>
          <div data-managed-practice-detail hidden>
            <p data-managed-practice-meta></p>
            <p data-managed-practice-counts></p>
            <div data-managed-signup-list></div>
            <form data-managed-signup-form>
              <fieldset class="dragon-boat-form-grid" data-managed-signup-fields>
                <label>搜索队员<input type="search" autocomplete="off" data-managed-signup-search /></label>
                <label>本次操作的队员<select data-managed-signup-member required></select></label>
                <label>本次训练偏好<select name="preference"><option value="LEFT">Left · 左侧</option><option value="AMBIENT">Ambient · 左右均可</option><option value="RIGHT">Right · 右侧</option></select></label>
                <p data-managed-signup-current></p>
                <p class="dragon-boat-field-wide dragon-boat-change-preview" data-managed-signup-preview></p>
                <div class="dragon-boat-button-row dragon-boat-field-wide">
                  <button type="submit" class="dragon-boat-primary-button" data-managed-signup-submit>代为报名</button>
                </div>
                <div class="dragon-boat-field-wide dragon-boat-cancel-signup" data-managed-signup-cancel-area hidden>
                  <label class="dragon-boat-check-label"><input type="checkbox" data-managed-signup-cancel-confirm /><span data-managed-signup-cancel-text></span></label>
                  <button type="button" class="dragon-boat-secondary-button" data-managed-signup-cancel>取消所选队员报名</button>
                </div>
              </fieldset>
            </form>
          </div>
          <p class="dragon-boat-form-status" data-managed-signup-status aria-live="polite"></p>
          <button type="button" class="dragon-boat-secondary-button" data-managed-signup-retry hidden>按原内容重试并确认结果</button>
        </section>

        <section class="dragon-boat-management-block dragon-boat-seat-editor" data-seat-console hidden aria-labelledby="seat-management-title">
          <div class="dragon-boat-section-heading">
            <div>
              <p class="dragon-boat-session-label">私有草稿与正式版本</p>
              <h3 id="seat-management-title">本次训练排座</h3>
            </div>
            <button type="button" class="dragon-boat-secondary-button" data-seat-refresh>刷新排座</button>
          </div>
          <p data-seat-mode></p>
          <p class="dragon-boat-form-status" data-seat-status aria-live="polite"></p>
          <div class="dragon-boat-seat-role-grid">
            <label>Coach<select data-seat-coach></select></label>
            <label>Steerer<select data-seat-steerer></select></label>
          </div>
          <div class="dragon-boat-seat-editor-layout">
            <section class="dragon-boat-seat-pool" aria-labelledby="seat-pool-title">
              <h4 id="seat-pool-title">待排座池</h4>
              <p>先点姓名，再点一个左／右船位。再次点船位可选择其中队员；可交换或移回池。</p>
              <div data-seat-pool></div>
              <button type="button" class="dragon-boat-secondary-button" data-seat-remove disabled>将所选队员移回池</button>
            </section>
            <section class="dragon-boat-seat-draft" aria-labelledby="seat-draft-title">
              <h4 id="seat-draft-title">Coach 私有草稿</h4>
              <p>每次调整会自动保存。公开页面只显示最近正式发布版本。</p>
              <div class="dragon-boat-seat-draft-boat" data-seat-draft-grid></div>
            </section>
            <section class="dragon-boat-seat-published" aria-labelledby="seat-published-title">
              <h4 id="seat-published-title">队员当前可见版本</h4>
              <div data-seat-published></div>
            </section>
          </div>
          <p class="dragon-boat-change-preview" data-seat-warnings></p>
          <div class="dragon-boat-button-row">
            <button type="button" class="dragon-boat-secondary-button" data-seat-undo disabled>撤销本地上一步</button>
            <button type="button" class="dragon-boat-secondary-button" data-seat-reset disabled>从正式版重置草稿</button>
            <button type="button" class="dragon-boat-secondary-button" data-seat-save disabled>立即保存草稿</button>
            <button type="button" class="dragon-boat-primary-button" data-seat-publish disabled>发布正式座位表</button>
          </div>
          <button type="button" class="dragon-boat-secondary-button" data-seat-retry hidden>按原草稿重试并确认结果</button>
        </section>
      </section>

      <details class="dragon-boat-connectivity-panel">
        <summary>P0 连接诊断</summary>
        <p>这项测试只向系统审计日志写入一条无业务副作用的事件。</p>
        <button type="button" class="dragon-boat-secondary-button" data-write-button>执行测试写入</button>
        <p class="dragon-boat-form-status" data-write-status aria-live="polite"></p>
      </details>
    </section>

    <p class="dragon-boat-note">Google 登录只用于维护原生 Form、Sheet 和 Apps Script；它不会代替 Coach Code 的网站管理会话。</p>
  </main>
</div>

<script>
  import { DragonBoatApiClient, DragonBoatApiError, createRequestId } from "../lib/api-client.js";
  import { clearCoachSession, isCoachSessionError, loadCoachSession, saveCoachSession } from "../lib/coach-session.js";
  import { renderSignupList, signupResultText } from "../lib/signup-view.js";
  import { validPracticeView, olderPracticeView } from "../lib/current-view.js";
  import { renderSeatPlan } from "../lib/seat-plan-view.js";

  const root = document.querySelector<HTMLElement>("[data-coach-mode-app]");
  const q = <T extends HTMLElement>(selector: string) => root?.querySelector<T>(selector) || null;
  const loginPanel = q<HTMLElement>("[data-login-panel]");
  const loginForm = q<HTMLFormElement>("[data-login-form]");
  const codeInput = q<HTMLInputElement>("[data-coach-code]");
  const loginButton = q<HTMLButtonElement>("[data-login-button]");
  const loginStatus = q<HTMLElement>("[data-login-status]");
  const workspace = q<HTMLElement>("[data-workspace]");
  const coachName = q<HTMLElement>("[data-coach-name]");
  const sessionExpiry = q<HTMLElement>("[data-session-expiry]");
  const panelGrid = q<HTMLElement>("[data-panel-grid]");
  const logoutButton = q<HTMLButtonElement>("[data-logout-button]");
  const refreshButton = q<HTMLButtonElement>("[data-refresh-button]");
  const managementStatus = q<HTMLElement>("[data-management-status]");
  const managementRetry = q<HTMLButtonElement>("[data-management-retry]");
  const seasonPicker = q<HTMLSelectElement>("[data-season-picker]");
  const openSeason = q<HTMLButtonElement>("[data-open-season]");
  const openMembers = q<HTMLButtonElement>("[data-open-members]");
  const createSeasonForm = q<HTMLFormElement>("[data-create-season-form]");
  const createSeasonDetails = q<HTMLDetailsElement>("[data-create-season-details]");
  const seasonDetail = q<HTMLElement>("[data-season-detail]");
  const seasonStatus = q<HTMLElement>("[data-season-status]");
  const seasonTitle = q<HTMLElement>("[data-season-title]");
  const seasonMeta = q<HTMLElement>("[data-season-meta]");
  const seasonSync = q<HTMLElement>("[data-season-sync]");
  const syncButton = q<HTMLButtonElement>("[data-sync-button]");
  const bindingBlock = q<HTMLElement>("[data-binding-block]");
  const bindingForm = q<HTMLFormElement>("[data-binding-form]");
  const bindingStatus = q<HTMLElement>("[data-binding-status]");
  const initializeButton = q<HTMLButtonElement>("[data-initialize-button]");
  const activeSeasonBlock = q<HTMLElement>("[data-active-season-block]");
  const templateForm = q<HTMLFormElement>("[data-template-form]");
  const templateRows = q<HTMLElement>("[data-template-rows]");
  const addTemplateButton = q<HTMLButtonElement>("[data-add-template-button]");
  const weekForm = q<HTMLFormElement>("[data-week-form]");
  const adminWeekList = q<HTMLElement>("[data-admin-week-list]");
  const additionalForm = q<HTMLFormElement>("[data-additional-form]");
  const additionalWeek = q<HTMLSelectElement>("[data-additional-week]");
  const writeButton = q<HTMLButtonElement>("[data-write-button]");
  const writeStatus = q<HTMLElement>("[data-write-status]");
  const memberConsole = q<HTMLElement>("[data-member-console]");
  const memberConsoleStatus = q<HTMLElement>("[data-member-console-status]");
  const memberRefresh = q<HTMLButtonElement>("[data-member-refresh]");
  const memberSearch = q<HTMLInputElement>("[data-member-search]");
  const memberPicker = q<HTMLSelectElement>("[data-member-picker]");
  const memberDetail = q<HTMLElement>("[data-member-detail]");
  const memberCount = q<HTMLElement>("[data-member-count]");
  const memberSource = q<HTMLElement>("[data-member-source]");
  const memberCurrentName = q<HTMLElement>("[data-member-current-name]");
  const memberState = q<HTMLElement>("[data-member-state]");
  const memberEditForm = q<HTMLFormElement>("[data-member-edit-form]");
  const memberEditFields = q<HTMLFieldSetElement>("[data-member-edit-fields]");
  const memberPreview = q<HTMLElement>("[data-member-preview]");
  const memberRestore = q<HTMLButtonElement>("[data-member-restore]");
  const memberLinks = q<HTMLElement>("[data-member-links]");
  const memberStatusConfirm = q<HTMLInputElement>("[data-member-status-confirm]");
  const memberStatusExplanation = q<HTMLElement>("[data-member-status-explanation]");
  const memberStatusButton = q<HTMLButtonElement>("[data-member-status-button]");
  const memberEditStatus = q<HTMLElement>("[data-member-edit-status]");
  const memberRetry = q<HTMLButtonElement>("[data-member-retry]");
  const managedPracticePicker = q<HTMLSelectElement>("[data-managed-practice-picker]");
  const managedPracticeRefresh = q<HTMLButtonElement>("[data-managed-practice-refresh]");
  const managedPracticeStatus = q<HTMLElement>("[data-managed-practice-status]");
  const managedPracticeDetail = q<HTMLElement>("[data-managed-practice-detail]");
  const managedPracticeMeta = q<HTMLElement>("[data-managed-practice-meta]");
  const managedPracticeCounts = q<HTMLElement>("[data-managed-practice-counts]");
  const managedSignupList = q<HTMLElement>("[data-managed-signup-list]");
  const managedSignupForm = q<HTMLFormElement>("[data-managed-signup-form]");
  const managedSignupFields = q<HTMLFieldSetElement>("[data-managed-signup-fields]");
  const managedSignupSearch = q<HTMLInputElement>("[data-managed-signup-search]");
  const managedSignupMember = q<HTMLSelectElement>("[data-managed-signup-member]");
  const managedSignupCurrent = q<HTMLElement>("[data-managed-signup-current]");
  const managedSignupPreview = q<HTMLElement>("[data-managed-signup-preview]");
  const managedSignupSubmit = q<HTMLButtonElement>("[data-managed-signup-submit]");
  const managedSignupCancelArea = q<HTMLElement>("[data-managed-signup-cancel-area]");
  const managedSignupCancelConfirm = q<HTMLInputElement>("[data-managed-signup-cancel-confirm]");
  const managedSignupCancelText = q<HTMLElement>("[data-managed-signup-cancel-text]");
  const managedSignupCancel = q<HTMLButtonElement>("[data-managed-signup-cancel]");
  const managedSignupStatus = q<HTMLElement>("[data-managed-signup-status]");
  const managedSignupRetry = q<HTMLButtonElement>("[data-managed-signup-retry]");
  const seatConsole = q<HTMLElement>("[data-seat-console]");
  const seatRefresh = q<HTMLButtonElement>("[data-seat-refresh]");
  const seatMode = q<HTMLElement>("[data-seat-mode]");
  const seatStatus = q<HTMLElement>("[data-seat-status]");
  const seatCoach = q<HTMLSelectElement>("[data-seat-coach]");
  const seatSteerer = q<HTMLSelectElement>("[data-seat-steerer]");
  const seatPool = q<HTMLElement>("[data-seat-pool]");
  const seatRemove = q<HTMLButtonElement>("[data-seat-remove]");
  const seatDraftGrid = q<HTMLElement>("[data-seat-draft-grid]");
  const seatPublished = q<HTMLElement>("[data-seat-published]");
  const seatWarnings = q<HTMLElement>("[data-seat-warnings]");
  const seatUndo = q<HTMLButtonElement>("[data-seat-undo]");
  const seatReset = q<HTMLButtonElement>("[data-seat-reset]");
  const seatSave = q<HTMLButtonElement>("[data-seat-save]");
  const seatPublish = q<HTMLButtonElement>("[data-seat-publish]");
  const seatRetry = q<HTMLButtonElement>("[data-seat-retry]");
  const apiUrl = root?.getAttribute("data-api-url")?.trim() || "";
  const client = apiUrl ? new DragonBoatApiClient({ baseUrl: apiUrl, timeoutMs: 30000 }) : null;
  const pendingRequests = new Map<string, { action: string; payload: Record<string, unknown>; requestId: string }>();
  let managementWriting = false;
  let sessionToken = "";
  // Keep only an in-memory fingerprint and request ID for an uncertain login.
  // The user re-enters the Code; neither the Code nor its digest is persisted.
  let pendingLogin: { codeDigest: string; requestId: string } | null = null;
  let loginInProgress = false;
  let currentSeasonData: any = null;
  let bindingValidated = false;
  let seasonReadVersion = 0;
  let p2ReadVersion = 0;
  let practiceReadVersion = 0;
  let p2SeasonId = "";
  let managedMembers: any[] = [];
  let managedRosterVersion = -1;
  let managedViewTime = "";
  let p2Practices: any[] = [];
  let managedPractice: any = null;
  let membersFresh = false;
  let practiceFresh = false;
  let p2Busy = false;
  let p2Refreshing = false;
  let p2Pending: { kind: "member" | "signup"; action: string; payload: Record<string, any>; requestId: string; accepted?: boolean; result?: any; draft?: any } | null = null;
  let draftAfterLogin: any = null;
  let managedSeating: any = null;
  let localSeatDraft: any = null;
  let seatSelectedMemberId = "";
  let seatHistory: any[] = [];
  let seatDirty = false;
  let seatSaving = false;
  let seatPublishing = false;
  let seatEditSequence = 0;
  let seatReadVersion = 0;
  let seatSaveTimer: number | undefined;
  let seatPendingPayload: Record<string, any> | null = null;
  let seatPendingAction = "";
  let seatPendingKey = "";
  let seatPendingSequence = -1;
  let seatPendingAccepted = false;
  let seatOutcomeUnknown = false;
  let seatServerConflict = false;
  let seatConflictServerReady = false;

  function setStatus(element: HTMLElement | null, message: string, state = "") {
    if (!element) return;
    element.textContent = message;
    element.dataset.state = state;
  }

  function messageForError(error: unknown) {
    const code = error instanceof DragonBoatApiError ? error.code : "UNKNOWN_ERROR";
    const messages: Record<string, string> = {
      COACH_CODE_INVALID: "Coach Code 不正确。",
      LOGIN_RATE_LIMITED: "尝试次数过多，请稍后再试。",
      SESSION_EXPIRED: "管理会话已过期，请重新输入 Coach Code。",
      SESSION_REVOKED: "这次管理会话已经失效，请重新登录。",
      SESSION_INVALID: "无法验证管理会话，请重新登录。",
      VERSION_CONFLICT: "数据已被其他管理员修改，请刷新后重试。",
      BINDING_DESTINATION_MISMATCH: "这个 Form 没有连接到所填的响应 Spreadsheet。",
      BINDING_RESPONSE_TAB_MISMATCH: "所选响应 Tab 不属于这个 Form。",
      BINDING_FIELD_MISSING: "响应 Tab 中找不到所填的姓名列标题。",
      BINDING_FIELD_AMBIGUOUS: "姓名列标题重复，请先修正响应表。",
      BINDING_SCHEMA_CHANGED: "响应表的列结构已经改变，请检查后再同步。",
      BINDING_LOCKED: "赛季已经激活，不能替换它的表单绑定。",
      WEEK_START_NOT_MONDAY: "请选择一个周一作为本周起点。",
      SCHEDULE_TEMPLATES_REQUIRED: "请先保存至少一条默认训练模板。",
      MEMBER_HAS_ACTIVE_LINKS: "这位队员仍关联未结束训练。请先处理下方列出的报名、座位或带队角色，再停用。",
      MEMBER_INACTIVE: "这位队员已停用，不能为其新增或修改报名。请先核对队员状态。",
      MEMBER_NOT_FOUND: "本季找不到这位队员，请刷新名册。",
      SIGNUP_EXISTS: "这位队员已经报名。已更新清单，请使用修改偏好或取消入口。",
      SIGNUP_NOT_ACTIVE: "这条报名已不存在或已取消，请核对刷新后的清单。",
      PRACTICE_ENDED: "训练已经结束，报名记录只读；最终座位更正在后续排座阶段处理。",
      PRACTICE_CANCELLED: "训练已取消，不能再修改报名。",
      SIGNUP_CLOSED: "这次训练当前不接受报名修改，请核对服务器状态。",
      ROLE_CONFLICT: "这位队员已担任本次训练的 Coach 或 Steerer，不能同时占用划桨名额。",
      ROLE_SIGNUP_CONFLICT: "带队人员仍有本次有效报名，请先在上方取消该报名。",
      MEMBER_IS_TRAINING_LEADER: "这位队员已担任本次 Coach 或 Steerer，不能报名划桨。",
      SEAT_MEMBER_NOT_CONFIRMED: "训练开始前，草稿船位只能放置本次已确认报名的队员。",
      SEAT_MEMBER_DUPLICATE: "同一位队员不能占用两个船位。",
      INVALID_SEAT_PLAN: "座位草稿格式不正确，请刷新并重新安排。",
      SEAT_PLAN_INCOMPLETE: "发布前必须为每一位已确认报名者安排一个船位。",
      PREFERENCE_ACK_REQUIRED: "草稿中有人被安排在与明确偏好不同的一侧，请核对后再次确认发布。",
      SEAT_PLAN_FROZEN: "训练结束已满 24 小时，最终座位表已经冻结。",
      SEASON_NOT_OPEN: "赛季当前不可修改，请刷新赛季状态。",
      SERVICE_BUSY: "系统正在处理其他修改，请稍后使用同一请求重试。",
      NETWORK_ERROR: "暂时无法连接训练服务。",
      REQUEST_TIMEOUT: "请求超时，暂时无法确认结果。"
    };
    return messages[code] || (error instanceof Error ? error.message : "操作没有完成，请稍后重试。");
  }

  function showLogin(message = "", state = "error", preserveDraft = false) {
    sessionToken = "";
    seasonReadVersion += 1;
    currentSeasonData = null;
    pendingRequests.clear();
    clearP2View();
    if (!preserveDraft) draftAfterLogin = null;
    if (loginPanel) loginPanel.hidden = false;
    if (workspace) workspace.hidden = true;
    if (panelGrid) panelGrid.replaceChildren();
    if (coachName) coachName.textContent = "Coach Mode";
    if (sessionExpiry) sessionExpiry.textContent = "";
    if (seasonPicker) seasonPicker.replaceChildren();
    if (seasonTitle) seasonTitle.textContent = "";
    if (seasonMeta) seasonMeta.textContent = "";
    if (seasonSync) seasonSync.textContent = "";
    if (adminWeekList) adminWeekList.replaceChildren();
    if (templateRows) templateRows.replaceChildren();
    if (additionalWeek) additionalWeek.replaceChildren();
    bindingForm?.reset();
    renderManagementRetry();
    setStatus(loginStatus, message, message ? state : "");
    if (loginButton) loginButton.disabled = !client;
    if (codeInput) codeInput.disabled = !client;
  }

  function protectedError(error: unknown) {
    if (error instanceof DragonBoatApiError && error.code === "STALE_SESSION_RESPONSE") return true;
    if (isCoachSessionError(error)) {
      const draft = captureP2Draft();
      draftAfterLogin = draft ? { ...draft, pending: p2Pending } : null;
      clearCoachSession();
      showLogin(messageForError(error), "error", true);
      return true;
    }
    return false;
  }

  async function managedPost(action: string, payload: Record<string, unknown>, key: string) {
    if (!client || !sessionToken) throw new Error("Coach Mode is not connected.");
    if (managementWriting) throw new DragonBoatApiError("REQUEST_IN_PROGRESS", "上一次操作仍在提交中，请等待服务器结果。");
    const pendingEntry = [...pendingRequests.entries()][0];
    if (pendingEntry && (pendingEntry[0] !== key || pendingEntry[1].action !== action || JSON.stringify(pendingEntry[1].payload) !== JSON.stringify(payload))) {
      throw new DragonBoatApiError("REQUEST_PENDING", "上一次操作结果尚未确认。当前修改尚未发送，请点击「按原内容重试上次操作」先确认原操作。", { retryable: true });
    }
    const request = pendingEntry?.[1] || { action, payload: structuredClone(payload), requestId: createRequestId() };
    const token = sessionToken;
    pendingRequests.set(key, request);
    managementWriting = true;
    renderManagementRetry();
    try {
      const response = await client.post(request.action, { ...request.payload, session_token: token }, { requestId: request.requestId });
      if (token !== sessionToken) throw new DragonBoatApiError("STALE_SESSION_RESPONSE", "已忽略旧会话返回的操作结果。");
      pendingRequests.delete(key);
      return response;
    } catch (error) {
      if (error instanceof DragonBoatApiError && !error.retryable && !["INVALID_RESPONSE", "CONTRACT_MISMATCH"].includes(error.code)) pendingRequests.delete(key);
      throw error;
    } finally {
      managementWriting = false;
      renderManagementRetry();
    }
  }

  function renderManagementRetry() {
    if (managementRetry) {
      managementRetry.hidden = !pendingRequests.size || !sessionToken;
      managementRetry.disabled = managementWriting;
    }
    updateP2Controls();
    updateSeatControls();
  }

  function formObject(form: HTMLFormElement) {
    return Object.fromEntries(new FormData(form).entries());
  }

  function renderPanels(panels: any[]) {
    if (!panelGrid) return;
    panelGrid.replaceChildren(...panels.map((panel) => {
      const card = document.createElement("section");
      card.className = "dragon-boat-panel-card";
      const title = document.createElement("h3");
      title.textContent = panel.label;
      const status = document.createElement("p");
      status.textContent = panel.available ? "已接入管理功能" : "将在后续阶段接入";
      card.append(title, status);
      return card;
    }));
  }

  async function refreshBootstrap(preferredSeasonId = "") {
    if (!client || !sessionToken) return;
    setStatus(managementStatus, "正在读取赛季入口……", "pending");
    const token = sessionToken;
    const response = await client.post("coachBootstrap", { session_token: token });
    if (token !== sessionToken) return;
    renderPanels(response.data.panels);
    if (coachName) coachName.textContent = response.data.coach.display_name;
    if (sessionExpiry) sessionExpiry.textContent = `会话有效至 ${new Date(response.data.session.expires_at).toLocaleString()}`;
    if (seasonPicker) {
      const current = preferredSeasonId || draftAfterLogin?.seasonId || seasonPicker.value || response.data.default_season_id || response.data.seasons[0]?.season_id || "";
      seasonPicker.replaceChildren();
      const empty = document.createElement("option");
      empty.value = "";
      empty.textContent = response.data.seasons.length ? "选择一个赛季" : "尚无赛季";
      seasonPicker.append(empty);
      response.data.seasons.forEach((season: any) => {
        const option = document.createElement("option");
        option.value = season.season_id;
        option.textContent = `${season.name} · ${season.status}${season.season_id === response.data.default_season_id ? " · 首页默认" : ""}`;
        seasonPicker.append(option);
      });
      seasonPicker.value = current;
      if (!current) clearSeasonView();
      else if (draftAfterLogin) await loadP2Season();
      else if (preferredSeasonId) await loadSeason(current);
      else setStatus(managementStatus, "请选择需要打开的工作区，其他数据将在使用时读取。", "ready");
      updateP2Controls();
    }
  }

  function clearSeasonView() {
    currentSeasonData = null;
    if (seasonDetail) seasonDetail.hidden = true;
    if (bindingBlock) bindingBlock.hidden = true;
    if (activeSeasonBlock) activeSeasonBlock.hidden = true;
    clearP2View();
  }

  async function loadSeason(seasonId: string) {
    if (!client || !sessionToken || !seasonId) return clearSeasonView();
    const token = sessionToken;
    const readVersion = ++seasonReadVersion;
    setStatus(managementStatus, "正在读取赛季……", "pending");
    try {
      const response = await client.post("getSeasonManagement", { session_token: sessionToken, season_id: seasonId });
      if (token !== sessionToken || readVersion !== seasonReadVersion) return;
      currentSeasonData = response.data;
      renderSeason();
      setStatus(managementStatus, "");
    } catch (error) {
      if (token !== sessionToken || readVersion !== seasonReadVersion) return;
      if (!protectedError(error)) setStatus(managementStatus, messageForError(error), "error");
    }
  }

  function renderSeason() {
    if (!currentSeasonData) return clearSeasonView();
    const season = currentSeasonData.season;
    if (seasonDetail) seasonDetail.hidden = false;
    if (seasonStatus) seasonStatus.textContent = `${season.status}${currentSeasonData.is_default ? " · 首页默认" : ""}`;
    if (seasonTitle) seasonTitle.textContent = season.name;
    if (seasonMeta) seasonMeta.textContent = `${season.start_date} 至 ${season.end_date} · ${season.timezone} · version ${season.season_version}`;
    if (seasonSync) seasonSync.textContent = season.status === "OPEN"
      ? `${currentSeasonData.members.length} 名队员 · 名单版本 ${season.roster_version} · 最近同步 ${season.last_sync_at ? new Date(season.last_sync_at).toLocaleString() : "尚无"}`
      : "连接完成后会自动激活赛季并导入已有回答。";
    if (syncButton) syncButton.hidden = season.status !== "OPEN";
    if (bindingBlock) bindingBlock.hidden = season.status !== "DRAFT";
    if (activeSeasonBlock) activeSeasonBlock.hidden = season.status !== "OPEN";
    bindingValidated = false;
    if (initializeButton) initializeButton.disabled = true;
    setStatus(bindingStatus, "");
    if (season.status === "OPEN") {
      renderTemplates(currentSeasonData.templates);
      renderAdminWeeks(currentSeasonData.weeks);
    }
  }

  function captureP2Draft() {
    if (!p2SeasonId) return null;
    return {
      seasonId: p2SeasonId,
      memberId: memberPicker?.value || "",
      memberFields: memberInputValues(),
      practiceId: managedPracticePicker?.value || "",
      signupMemberId: managedSignupMember?.value || "",
      preference: (managedSignupForm?.elements.namedItem("preference") as HTMLSelectElement | null)?.value || "AMBIENT",
      seatDraft: localSeatDraft ? structuredClone(localSeatDraft) : null,
      seatBaseVersion: managedSeating?.seat_plan_version,
      seatBaseSignupVersion: managedSeating?.signup_version,
      seatBasePracticeVersion: managedSeating?.practice?.practice_version,
      seatBasePublishedRevision: managedSeating?.published_revision,
      seatWasDirty: seatDirty,
      seatSelectedMemberId
    };
  }

  function memberInputValues() {
    if (!memberEditForm) return null;
    return {
      display_name_override: (memberEditForm.elements.namedItem("display_name_override") as HTMLInputElement).value,
      default_preference: (memberEditForm.elements.namedItem("default_preference") as HTMLSelectElement).value
    };
  }

  function clearP2View() {
    p2ReadVersion += 1;
    practiceReadVersion += 1;
    seatReadVersion += 1;
    p2SeasonId = "";
    managedMembers = [];
    managedRosterVersion = -1;
    managedViewTime = "";
    p2Practices = [];
    managedPractice = null;
    membersFresh = false;
    practiceFresh = false;
    p2Pending = null;
    p2Busy = false;
    p2Refreshing = false;
    if (seatSaveTimer !== undefined) window.clearTimeout(seatSaveTimer);
    seatSaveTimer = undefined;
    managedSeating = null;
    localSeatDraft = null;
    seatSelectedMemberId = "";
    seatHistory = [];
    seatDirty = false;
    seatSaving = false;
    seatPublishing = false;
    seatPendingPayload = null;
    seatPendingAction = "";
    seatPendingKey = "";
    seatPendingSequence = -1;
    seatPendingAccepted = false;
    seatOutcomeUnknown = false;
    seatServerConflict = false;
    seatConflictServerReady = false;
    if (memberConsole) memberConsole.hidden = true;
    if (memberDetail) memberDetail.hidden = true;
    if (managedPracticeDetail) managedPracticeDetail.hidden = true;
    if (seatConsole) seatConsole.hidden = true;
    [memberPicker, managedPracticePicker, managedSignupMember, managedSignupList, memberLinks].forEach((element) => element?.replaceChildren());
    [memberConsoleStatus, memberCount, memberSource, memberCurrentName, memberState, memberPreview, memberStatusExplanation, memberEditStatus,
      managedPracticeStatus, managedPracticeMeta, managedPracticeCounts, managedSignupCurrent, managedSignupPreview, managedSignupCancelText, managedSignupStatus]
      .forEach((element) => setStatus(element, ""));
    [seatMode, seatStatus, seatWarnings].forEach((element) => setStatus(element, ""));
    [seatCoach, seatSteerer, seatPool, seatDraftGrid, seatPublished].forEach((element) => element?.replaceChildren());
    if (memberSearch) memberSearch.value = "";
    if (managedSignupSearch) managedSignupSearch.value = "";
    memberEditForm?.reset();
    managedSignupForm?.reset();
    if (memberStatusConfirm) memberStatusConfirm.checked = false;
    if (memberStatusButton) memberStatusButton.textContent = "";
    updateP2Controls();
  }

  function currentMember() {
    return managedMembers.find((member) => member.member_id === memberPicker?.value);
  }

  function currentManagedSignup() {
    return managedPractice?.signups?.find((signup: any) => signup.member_id === managedSignupMember?.value);
  }

  function seatEditBlocked() {
    return !managedSeating?.editable || seatServerConflict || seatPublishing || seatOutcomeUnknown || seatPendingAccepted;
  }

  function seatContextNeedsResolution() {
    return Boolean(managedSeating && (seatDirty || seatSaving || seatPublishing || seatPendingPayload || seatServerConflict));
  }

  function updateP2Controls(updateSeats = true) {
    const locked = p2Busy || Boolean(p2Pending) || managementWriting;
    const seatLocked = seatContextNeedsResolution();
    [memberSearch, memberPicker, memberRefresh, managedPracticePicker, managedPracticeRefresh].forEach((control) => {
      if (control) control.disabled = locked;
    });
    if (memberEditFields) memberEditFields.disabled = locked || seatLocked || !membersFresh || !currentMember();
    if (managedSignupFields) managedSignupFields.disabled = locked || seatLocked || !membersFresh || !practiceFresh || !managedPractice?.management_signup_open;
    if (seasonPicker) seasonPicker.disabled = locked || seatLocked || pendingRequests.size > 0;
    if (refreshButton) refreshButton.disabled = locked || seatLocked || pendingRequests.size > 0;
    if (openSeason) openSeason.disabled = locked || seatLocked || p2Refreshing || pendingRequests.size > 0 || !seasonPicker?.value;
    if (openMembers) openMembers.disabled = locked || seatLocked || p2Refreshing || pendingRequests.size > 0 || !seasonPicker?.value;
    if (memberRefresh) memberRefresh.disabled = locked || p2Refreshing;
    if (managedPracticeRefresh) managedPracticeRefresh.disabled = locked || p2Refreshing;
    if (managedPracticePicker) managedPracticePicker.disabled = locked || seatLocked || p2Refreshing;
    if (seasonPicker) seasonPicker.disabled ||= p2Refreshing;
    memberEditForm?.querySelectorAll<HTMLButtonElement>('button[type="submit"]').forEach(button => {
      button.disabled = locked || seatLocked || p2Refreshing || !membersFresh || !currentMember();
    });
    const member = currentMember();
    const cannotDeactivate = member?.status === "ACTIVE" && member?.active_links?.length > 0;
    if (memberStatusConfirm) memberStatusConfirm.disabled = locked || seatLocked || !membersFresh || !member || cannotDeactivate;
    if (memberStatusButton) memberStatusButton.disabled = locked || seatLocked || p2Refreshing || !membersFresh || !member || cannotDeactivate || !memberStatusConfirm?.checked;
    if (memberRestore) memberRestore.disabled = locked || seatLocked || p2Refreshing || !membersFresh || !member?.display_name_override;
    if (memberRetry) {
      memberRetry.hidden = p2Pending?.kind !== "member";
      memberRetry.disabled = p2Busy || p2Refreshing || !sessionToken;
      memberRetry.textContent = p2Pending?.accepted ? "重新读取已保存结果" : "按原内容重试并确认结果";
    }
    if (managedSignupRetry) {
      managedSignupRetry.hidden = p2Pending?.kind !== "signup";
      managedSignupRetry.disabled = p2Busy || p2Refreshing || !sessionToken;
      managedSignupRetry.textContent = p2Pending?.accepted ? "重新读取已保存结果" : "按原内容重试并确认结果";
    }
    if (managedSignupCancel) managedSignupCancel.disabled = locked || seatLocked || !membersFresh || !practiceFresh || !managedSignupCancelConfirm?.checked || !managedPractice?.management_signup_open;
    const signupMember = managedMembers.find((item) => item.member_id === managedSignupMember?.value);
    if (managedSignupSubmit) managedSignupSubmit.disabled = locked || seatLocked || p2Refreshing || !membersFresh || !practiceFresh || !managedPractice?.management_signup_open || signupMember?.status !== "ACTIVE";
    if (managedSignupCancel) managedSignupCancel.disabled ||= p2Refreshing;
    if (updateSeats) updateSeatControls();
  }

  async function loadP2Season() {
    const seasonId = seasonPicker?.value;
    if (!client || !sessionToken || !seasonId) return clearP2View();
    const changed = seasonId !== p2SeasonId;
    if (changed) clearP2View();
    p2SeasonId = seasonId;
    const token = sessionToken;
    if (memberConsole) memberConsole.hidden = false;
    const draft = draftAfterLogin?.seasonId === p2SeasonId ? draftAfterLogin : p2Pending ? captureP2Draft() : null;
    p2Refreshing = true;
    updateP2Controls();
    setStatus(memberConsoleStatus, "正在读取受保护名册与最新报名……", "pending");
    try {
      await readMemberWorkspace(draft, !changed);
      if (token !== sessionToken || p2SeasonId !== seasonId) return;
      if (draft?.pending) {
        p2Pending = draft.pending;
        setStatus(p2Pending?.kind === "member" ? memberEditStatus : managedSignupStatus, p2Pending?.accepted
          ? "会话已恢复，服务器此前已确认保存。请重新读取已保存结果，不会再次发送写入。"
          : "会话已恢复，原请求内容及编号保持不变。请使用原内容重试按钮确认结果。", "pending");
      }
      setStatus(memberConsoleStatus, draft ? "已重新核对服务器版本。未提交的输入已恢复，请检查后再次确认。" : "名册与报名已更新。", "ready");
      if (draft) draftAfterLogin = null;
    } catch (error) {
      if (token !== sessionToken || p2SeasonId !== seasonId) return;
      if (!protectedError(error)) setStatus(memberConsoleStatus, `读取失败，显示的数据可能已过期。${messageForError(error)}`, "error");
    } finally {
      if (token === sessionToken) {
        p2Refreshing = false;
        updateP2Controls();
      }
    }
  }

  function applyManagedView(view: any, draft: any = null) {
    if (!view || view.season_id !== p2SeasonId || !Number.isInteger(view.roster_version)
        || view.roster_version < managedRosterVersion) return false;
    const practiceId = managedPracticePicker?.value;
    if (practiceId && !validPracticeView(view.practice, p2SeasonId, practiceId)) return false;
    if (!Array.isArray(view.members) && (!membersFresh || view.roster_version !== managedRosterVersion)) return false;
    if (Date.parse(view.generated_at) < Date.parse(managedViewTime)
        || (view.practice && olderPracticeView(view.practice, managedPractice))) return membersFresh && practiceFresh;
    if (!view.member_links || typeof view.member_links !== "object") return false;
    if (Array.isArray(view.members)) managedMembers = view.members;
    managedMembers = managedMembers.map(member => ({ ...member, active_links: view.member_links[member.member_id] || [] }));
    managedRosterVersion = view.roster_version;
    managedViewTime = view.generated_at;
    membersFresh = true;
    renderMemberPicker(draft?.memberId || memberPicker?.value);
    renderMemberDetail(draft?.memberFields);
    if (view.practice) {
      managedPractice = view.practice;
      practiceFresh = true;
      renderManagedPractice(draft);
      applySeatingWorkspace(view.seating, draft);
    } else {
      managedPractice = null;
      practiceFresh = false;
      managedSeating = null;
      localSeatDraft = null;
      if (managedPracticeDetail) managedPracticeDetail.hidden = true;
      if (seatConsole) seatConsole.hidden = true;
    }
    if (currentSeasonData?.season.season_id === p2SeasonId) {
      currentSeasonData.season.roster_version = managedRosterVersion;
      if (seasonSync) seasonSync.textContent = `${managedMembers.length} 名队员 · 名单版本 ${managedRosterVersion}`;
    }
    updateP2Controls();
    return true;
  }

  async function readMemberWorkspace(draft: any = null, preserveInput = false) {
    if (!client || !sessionToken || !p2SeasonId) return;
    const token = sessionToken, seasonId = p2SeasonId, revision = ++p2ReadVersion;
    const practiceId = draft?.practiceId || managedPracticePicker?.value || "";
    let response;
    try {
      response = await client.post("getMemberWorkspace", { session_token: token, season_id: seasonId,
        ...(practiceId ? { practice_id: practiceId } : {}), known_roster_version: managedRosterVersion });
    } catch (error) {
      if (!(error instanceof DragonBoatApiError) || error.code !== "UNSUPPORTED_ACTION") throw error;
      // Rolling deployment: older service versions still supply the P2 reads.
      await loadSeason(seasonId);
      if (token !== sessionToken || seasonId !== p2SeasonId) return;
      p2Practices = (currentSeasonData?.weeks || []).flatMap((week: any) => week.practices).filter((practice: any) => practice.schedule_published_at);
      renderManagedPracticePicker(practiceId);
      await loadManagedMembers(preserveInput ? captureP2Draft() : draft);
      await loadManagedPractice(preserveInput ? captureP2Draft() : draft);
      return;
    }
    if (token !== sessionToken || seasonId !== p2SeasonId || revision !== p2ReadVersion) return;
    const latestDraft = preserveInput ? captureP2Draft() : draft;
    p2Practices = response.data.practices;
    renderManagedPracticePicker(practiceId);
    if (!applyManagedView(response.data, latestDraft)) throw new Error("管理视图不完整，请重新读取。");
  }

  async function loadManagedMembers(draft: any = null) {
    if (!client || !sessionToken || !p2SeasonId) return;
    const token = sessionToken;
    const seasonId = p2SeasonId;
    const revision = ++p2ReadVersion;
    membersFresh = false;
    const response = await client.post("listSeasonMembers", { session_token: token, season_id: seasonId });
    if (token !== sessionToken || seasonId !== p2SeasonId || revision !== p2ReadVersion) return;
    if (response.data.roster_version < managedRosterVersion) return;
    managedMembers = response.data.members;
    managedRosterVersion = response.data.roster_version;
    membersFresh = true;
    renderMemberPicker(draft?.memberId || memberPicker?.value);
    renderMemberDetail(draft?.memberFields);
    if (currentSeasonData?.season.season_id === seasonId) {
      currentSeasonData.season.roster_version = response.data.roster_version;
      if (seasonSync) seasonSync.textContent = `${managedMembers.length} 名队员 · 名单版本 ${response.data.roster_version} · 最近同步 ${currentSeasonData.season.last_sync_at ? new Date(currentSeasonData.season.last_sync_at).toLocaleString() : "尚无"}`;
    }
  }

  function renderMemberPicker(preferred = "") {
    if (!memberPicker) return;
    const query = memberSearch?.value.trim().toLocaleLowerCase() || "";
    const matches = managedMembers.filter((member) => `${member.display_name} ${member.source_display_name}`.toLocaleLowerCase().includes(query));
    memberPicker.replaceChildren(...matches.map((member) => {
      const option = document.createElement("option");
      option.value = member.member_id;
      option.textContent = `${member.display_name}${member.status === "INACTIVE" ? " · 已停用" : ""} · ${String(member.member_id).slice(-6)}`;
      return option;
    }));
    memberPicker.value = matches.some((member) => member.member_id === preferred) ? preferred : matches[0]?.member_id || "";
    if (memberCount) memberCount.textContent = `${matches.length} 个匹配结果 / 本季 ${managedMembers.length} 位队员（含停用）`;
  }

  function renderMemberDetail(fields: any = null) {
    const member = currentMember();
    if (memberDetail) memberDetail.hidden = !member;
    if (!member || !memberEditForm) return updateP2Controls();
    if (memberSource) memberSource.textContent = member.source_display_name;
    if (memberCurrentName) memberCurrentName.textContent = member.display_name;
    if (memberState) memberState.textContent = `${member.status === "ACTIVE" ? "有效" : "已停用"} · v${member.member_version}`;
    (memberEditForm.elements.namedItem("display_name_override") as HTMLInputElement).value = String(fields?.display_name_override ?? member.display_name_override ?? "");
    (memberEditForm.elements.namedItem("default_preference") as HTMLSelectElement).value = String(fields?.default_preference ?? member.default_preference ?? "AMBIENT");
    if (memberStatusConfirm) memberStatusConfirm.checked = false;
    if (memberStatusButton) memberStatusButton.textContent = member.status === "ACTIVE" ? "停用这位队员" : "重新启用这位队员";
    if (memberStatusExplanation) memberStatusExplanation.textContent = member.status === "ACTIVE"
      ? `我已核对，停用「${member.display_name}」后将不能再报名训练。`
      : `我已核对，重新启用「${member.display_name}」恢复本季报名资格。`;
    if (memberLinks) {
      memberLinks.replaceChildren();
      const title = document.createElement("p");
      title.textContent = member.active_links?.length ? "停用前需要处理的未结束训练关联：" : "没有未结束训练关联，可按需要停用。";
      memberLinks.append(title);
      const list = document.createElement("ul");
      (member.active_links || []).forEach((link: any) => {
        const item = document.createElement("li");
        const kind = ({ SIGNUP: "报名", SEAT: "座位", COACH: "Coach", STEERER: "Steerer" } as Record<string, string>)[link.kind] || link.kind;
        item.textContent = `${new Date(link.start_at).toLocaleString()} · ${kind}`;
        list.append(item);
      });
      memberLinks.append(list);
    }
    renderMemberPreview();
    updateP2Controls();
  }

  function renderMemberPreview() {
    const member = currentMember();
    if (!member || !memberEditForm || !memberPreview) return;
    const fields = memberInputValues()!;
    const nextName = String(fields.display_name_override || "").trim() || member.source_display_name;
    memberPreview.textContent = `保存后：${member.display_name} → ${nextName}；默认偏好 ${member.default_preference} → ${fields.default_preference}。成员编号、已有报名及排队时间保持不变。`;
  }

  function renderManagedPracticePicker(preferred = "") {
    if (!managedPracticePicker) return;
    const old = preferred || managedPracticePicker.value;
    const practices = p2Practices;
    managedPracticePicker.replaceChildren(...practices.map((practice: any) => {
      const option = document.createElement("option");
      option.value = practice.practice_id;
      option.textContent = `${new Date(practice.start_at).toLocaleString()} · ${practice.location}${practice.cancelled_at || practice.cancelled ? " · 已取消" : ""}`;
      return option;
    }));
    managedPracticePicker.value = practices.some((practice: any) => practice.practice_id === old) ? old : practices[0]?.practice_id || "";
    if (!practices.length) setStatus(managedPracticeStatus, "本季尚无已发布训练。请先确认周计划或发布加场。");
  }

  async function loadManagedPractice(draft: any = null) {
    if (!client || !sessionToken || !p2SeasonId) return;
    const practiceId = managedPracticePicker?.value;
    if (!practiceId) {
      practiceFresh = false;
      managedPractice = null;
      if (managedPracticeDetail) managedPracticeDetail.hidden = true;
      return updateP2Controls();
    }
    const token = sessionToken;
    const seasonId = p2SeasonId;
    const revision = ++practiceReadVersion;
    setStatus(managedPracticeStatus, "正在读取最新训练报名……", "pending");
    const response = await client.get("practice", { season_id: seasonId, practice_id: practiceId });
    if (token !== sessionToken || seasonId !== p2SeasonId || revision !== practiceReadVersion || practiceId !== managedPracticePicker?.value) return;
    const next = { ...response.data, generated_at: response.data.generated_at || response.meta?.server_time };
    if (!validPracticeView(next, seasonId, practiceId)) throw new Error("训练视图不完整，请刷新。");
    if (olderPracticeView(next, managedPractice)) return;
    managedPractice = next;
    practiceFresh = true;
    renderManagedPractice(draft);
  }

  function renderManagedPractice(draft: any = null) {
    if (!managedPractice) return;
    if (managedPracticeDetail) managedPracticeDetail.hidden = false;
    const practice = managedPractice.practice;
    if (managedPracticeMeta) managedPracticeMeta.textContent = `${new Date(practice.start_at).toLocaleString()} – ${new Date(practice.end_at).toLocaleString()} · ${practice.timezone} · ${practice.location} · 训练 v${practice.practice_version} / 报名 v${managedPractice.signup_version}`;
    const counts = managedPractice.counts;
    if (managedPracticeCounts) managedPracticeCounts.textContent = `已确认 ${counts.confirmed}/${counts.total_capacity} · 候补 ${counts.waitlisted} · Left ${counts.left}/${counts.left_capacity} · Ambient ${counts.ambient} · Right ${counts.right}/${counts.right_capacity}`;
    if (managedSignupList) renderSignupList(managedSignupList, managedPractice.signups);
    renderManagedSignupMemberPicker(draft?.signupMemberId || managedSignupMember?.value);
    renderManagedSignupSelection(draft?.preference);
    setStatus(managedPracticeStatus, managedPractice.management_signup_open
      ? (managedPractice.signup_open ? "普通报名与管理操作均开放。" : "普通报名已截止，管理员仍可在训练结束前修改报名。")
      : `报名记录只读。${closedPracticeMessage(managedPractice.closed_reason)}`, managedPractice.management_signup_open ? "ready" : "");
    updateP2Controls();
  }

  function closedPracticeMessage(reason: string) {
    return ({ PRACTICE_ENDED: "训练已经结束。", PRACTICE_CANCELLED: "训练已取消。", SEASON_COMPLETED: "赛季已完成。", SEASON_NOT_OPEN: "赛季未开放。", SIGNUP_CLOSED: "当前不接受报名修改。" } as Record<string, string>)[reason] || "以服务器最新状态为准。";
  }

  function cloneSeatDraft(value: any) {
    const seats = Array.isArray(value?.seats) ? value.seats.filter((item: any) =>
      Number.isInteger(Number(item?.row_number)) && Number(item.row_number) >= 1 && Number(item.row_number) <= 10
      && ["LEFT", "RIGHT"].includes(String(item?.side)) && item?.member_id
    ).map((item: any) => ({ row_number: Number(item.row_number), side: String(item.side), member_id: String(item.member_id) })) : [];
    return {
      coach_member_id: String(value?.coach_member_id || ""),
      steerer_member_id: String(value?.steerer_member_id || ""),
      seats
    };
  }

  function seatWorkspaceVersionKey(value: any) {
    return [
      Number(value?.practice?.practice_version ?? managedPractice?.practice?.practice_version ?? -1),
      Number(value?.signup_version ?? -1),
      Number(value?.seat_plan_version ?? -1),
      Number(value?.published_revision ?? -1)
    ].join(":");
  }

  function preservedSeatVersionsMatch(preserved: any, next: any) {
    return Number(preserved?.seatBaseVersion) === Number(next?.seat_plan_version)
      && Number(preserved?.seatBaseSignupVersion) === Number(next?.signup_version)
      && Number(preserved?.seatBasePracticeVersion) === Number(next?.practice?.practice_version ?? managedPractice?.practice?.practice_version)
      && Number(preserved?.seatBasePublishedRevision) === Number(next?.published_revision);
  }

  function applySeatingWorkspace(value: any, preserved: any = null) {
    const next = value?.seating || value;
    if (!next || !next.draft || !Number.isInteger(Number(next.seat_plan_version))) {
      managedSeating = null;
      localSeatDraft = null;
      if (seatConsole) seatConsole.hidden = true;
      return;
    }
    const previousVersionKey = seatWorkspaceVersionKey(managedSeating);
    const localWasDirty = seatDirty && localSeatDraft;
    managedSeating = next;
    if (preserved?.seatDraft && preserved.practiceId === managedPractice?.practice?.practice_id
        && preservedSeatVersionsMatch(preserved, next)) {
      localSeatDraft = cloneSeatDraft(preserved.seatDraft);
      seatSelectedMemberId = String(preserved.seatSelectedMemberId || "");
      seatDirty = JSON.stringify(localSeatDraft) !== JSON.stringify(cloneSeatDraft(next.draft));
      seatServerConflict = false;
      seatConflictServerReady = false;
    } else if (preserved?.seatDraft && preserved?.seatWasDirty
        && preserved.practiceId === managedPractice?.practice?.practice_id) {
      localSeatDraft = cloneSeatDraft(preserved.seatDraft);
      seatSelectedMemberId = String(preserved.seatSelectedMemberId || "");
      seatDirty = true;
      seatServerConflict = true;
      seatConflictServerReady = true;
      setStatus(seatStatus, "重新登录期间服务器版本已经变化。当前本地草稿已保留；请先核对并采用服务器草稿，再重新安排。", "error");
    } else if (localWasDirty && previousVersionKey !== seatWorkspaceVersionKey(next)) {
      seatServerConflict = true;
      seatConflictServerReady = true;
      setStatus(seatStatus, "服务器排座在本地草稿编辑期间发生了变化。当前输入已保留；请先采用服务器草稿，或刷新后重新安排。", "error");
    } else if (!localWasDirty || !localSeatDraft) {
      localSeatDraft = cloneSeatDraft(next.draft);
      seatDirty = false;
      seatServerConflict = false;
      seatConflictServerReady = false;
      seatHistory = [];
    }
    if (seatConsole) seatConsole.hidden = false;
    renderSeatEditor();
  }

  function seatMember(memberId: string) {
    return managedMembers.find((member) => member.member_id === memberId);
  }

  function seatSignup(memberId: string) {
    return managedPractice?.signups?.find((signup: any) => signup.member_id === memberId && signup.status !== "CANCELLED");
  }

  function preferenceShort(memberId: string) {
    const preference = seatSignup(memberId)?.preference || seatMember(memberId)?.default_preference || "AMBIENT";
    return ({ LEFT: "L", AMBIENT: "A", RIGHT: "R" } as Record<string, string>)[preference] || "A";
  }

  function selectedDraftSeat(memberId = seatSelectedMemberId) {
    return localSeatDraft?.seats?.find((item: any) => item.member_id === memberId) || null;
  }

  function createRoleOptions(select: HTMLSelectElement | null, selected: string) {
    if (!select) return;
    const empty = document.createElement("option");
    empty.value = "";
    empty.textContent = "尚未设置";
    const options = managedMembers.map((member) => {
      const option = document.createElement("option");
      option.value = member.member_id;
      const activeSignup = seatSignup(member.member_id);
      option.textContent = `${member.display_name}${activeSignup && managedSeating?.mode === "UPCOMING" ? " · 请先取消报名" : ""}`;
      option.disabled = Boolean(activeSignup && managedSeating?.mode === "UPCOMING" && member.member_id !== selected);
      return option;
    });
    select.replaceChildren(empty, ...options);
    select.value = selected;
  }

  function renderSeatEditor() {
    if (!managedSeating || !localSeatDraft || !managedPractice) {
      if (seatConsole) seatConsole.hidden = true;
      return;
    }
    if (seatConsole) seatConsole.hidden = false;
    const modeLabels: Record<string, string> = {
      UPCOMING: "训练前排座：正式发布前必须为每位确认报名者安排一个船位。",
      FINAL_CORRECTION: `最终座位表更正：报名记录保持不变，可更正实际出席与带队人员，截止 ${new Date(managedSeating.archive_due_at).toLocaleString()}。`,
      FROZEN: "最终更正时间已到，当前正式版本只读。",
      CANCELLED: "训练已取消，排座只读。"
    };
    if (seatMode) seatMode.textContent = `${modeLabels[managedSeating.mode] || "以服务器状态为准。"} 草稿 v${managedSeating.seat_plan_version} · 正式 revision ${managedSeating.published_revision || 0}`;
    createRoleOptions(seatCoach, localSeatDraft.coach_member_id);
    createRoleOptions(seatSteerer, localSeatDraft.steerer_member_id);

    const occupied = new Set(localSeatDraft.seats.map((item: any) => item.member_id));
    const roleIds = new Set([localSeatDraft.coach_member_id, localSeatDraft.steerer_member_id].filter(Boolean));
    const candidateIds: string[] = managedSeating.mode === "FINAL_CORRECTION"
      ? managedMembers.map((member) => String(member.member_id))
      : (managedPractice.signups || []).filter((signup: any) => signup.status === "CONFIRMED").map((signup: any) => String(signup.member_id));
    const poolMembers = [...new Set<string>(candidateIds)]
      .filter((memberId) => !occupied.has(memberId) && !roleIds.has(memberId))
      .map((memberId) => seatMember(memberId)).filter(Boolean);
    if (seatPool) {
      seatPool.replaceChildren(...poolMembers.map((member: any) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "dragon-boat-seat-person";
        button.dataset.memberId = member.member_id;
        button.disabled = seatEditBlocked();
        button.draggable = !seatEditBlocked();
        button.setAttribute("aria-pressed", String(seatSelectedMemberId === member.member_id));
        const name = document.createElement("strong");
        name.textContent = member.display_name;
        const detail = document.createElement("span");
        detail.textContent = `${preferenceShort(member.member_id)} · ${managedSeating.mode === "FINAL_CORRECTION" ? "本季成员" : "已确认待排座"}`;
        button.append(name, detail);
        button.addEventListener("click", () => {
          seatSelectedMemberId = seatSelectedMemberId === member.member_id ? "" : member.member_id;
          renderSeatEditor();
        });
        button.addEventListener("dragstart", (event) => event.dataTransfer?.setData("text/plain", member.member_id));
        return button;
      }));
      if (!poolMembers.length) {
        const empty = document.createElement("p");
        empty.textContent = managedSeating.mode === "FINAL_CORRECTION" ? "全部可用成员已安排或设为带队人员。" : "没有已确认且待排座的队员。";
        seatPool.append(empty);
      }
    }
    if (seatDraftGrid) {
      const rows = Array.from({ length: 10 }, (_, index) => index + 1).map((rowNumber) => {
        const row = document.createElement("div");
        row.className = "dragon-boat-seat-draft-row";
        const left = createSeatTarget(rowNumber, "LEFT");
        const number = document.createElement("span");
        number.textContent = String(rowNumber);
        const right = createSeatTarget(rowNumber, "RIGHT");
        row.append(left, number, right);
        return row;
      });
      seatDraftGrid.replaceChildren(...rows);
    }
    if (seatPublished) renderSeatPlan(seatPublished, managedSeating.published || managedPractice.seat_plan, {
      timeZone: managedPractice.practice?.timezone
    });
    const mismatches = localSeatDraft.seats.filter((item: any) => {
      const preference = seatSignup(item.member_id)?.preference;
      return (preference === "LEFT" && item.side !== "LEFT") || (preference === "RIGHT" && item.side !== "RIGHT");
    });
    if (seatWarnings) seatWarnings.textContent = mismatches.length
      ? `偏好提醒：${mismatches.map((item: any) => seatMember(item.member_id)?.display_name || item.member_id).join("、")} 的明确左右偏好与草稿船位不一致。允许发布，但必须再次确认。`
      : "发布会建立新的不可变正式 revision；之后的草稿修改不会影响队员当前看到的版本。";
    updateSeatControls();
  }

  function createSeatTarget(rowNumber: number, side: "LEFT" | "RIGHT") {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "dragon-boat-seat-target";
    const occupant = localSeatDraft?.seats?.find((item: any) => item.row_number === rowNumber && item.side === side);
    button.setAttribute("aria-label", `第 ${rowNumber} 排${side === "LEFT" ? "左侧" : "右侧"}${occupant ? `，${seatMember(occupant.member_id)?.display_name || "已有队员"}` : "，空位"}`);
    button.setAttribute("aria-pressed", String(Boolean(occupant && occupant.member_id === seatSelectedMemberId)));
    const name = document.createElement("strong");
    name.textContent = occupant ? seatMember(occupant.member_id)?.display_name || "未知队员" : "空位";
    const detail = document.createElement("span");
    detail.textContent = occupant ? `${preferenceShort(occupant.member_id)} · ${side}` : side;
    button.append(name, detail);
    button.disabled = seatEditBlocked();
    button.draggable = Boolean(occupant && !button.disabled);
    button.addEventListener("click", () => handleSeatTarget(rowNumber, side, occupant));
    button.addEventListener("dragstart", (event) => {
      if (occupant) event.dataTransfer?.setData("text/plain", occupant.member_id);
    });
    button.addEventListener("dragover", (event) => {
      if (!button.disabled) event.preventDefault();
    });
    button.addEventListener("drop", (event) => {
      if (button.disabled) return;
      event.preventDefault();
      const memberId = event.dataTransfer?.getData("text/plain") || "";
      if (!seatMember(memberId)) return;
      seatSelectedMemberId = memberId;
      handleSeatTarget(rowNumber, side, occupant);
    });
    return button;
  }

  function handleSeatTarget(rowNumber: number, side: "LEFT" | "RIGHT", occupant: any) {
    if (seatEditBlocked()) return;
    if (!seatSelectedMemberId) {
      if (occupant) {
        seatSelectedMemberId = occupant.member_id;
        renderSeatEditor();
      }
      return;
    }
    if (occupant?.member_id === seatSelectedMemberId) {
      seatSelectedMemberId = "";
      return renderSeatEditor();
    }
    const before = cloneSeatDraft(localSeatDraft);
    const source = selectedDraftSeat();
    localSeatDraft.seats = localSeatDraft.seats.filter((item: any) => item.member_id !== seatSelectedMemberId
      && !(item.row_number === rowNumber && item.side === side));
    if (occupant && source) localSeatDraft.seats.push({ ...source, member_id: occupant.member_id });
    localSeatDraft.seats.push({ row_number: rowNumber, side, member_id: seatSelectedMemberId });
    seatHistory.push(before);
    if (seatHistory.length > 20) seatHistory.shift();
    seatSelectedMemberId = "";
    markSeatDirty("EDIT");
  }

  function markSeatDirty(changeKind = "EDIT") {
    seatDirty = true;
    seatEditSequence += 1;
    renderSeatEditor();
    setStatus(seatStatus, "草稿有未保存调整，系统即将自动保存……", "pending");
    scheduleSeatSave(changeKind);
  }

  function scheduleSeatSave(changeKind = "EDIT") {
    if (seatSaveTimer !== undefined) window.clearTimeout(seatSaveTimer);
    seatSaveTimer = window.setTimeout(() => { saveSeatDraft(changeKind); }, 650);
  }

  function updateSeatControls() {
    const editBlocked = seatEditBlocked();
    const unresolved = seatOutcomeUnknown || seatPendingAccepted;
    if (seatCoach) seatCoach.disabled = editBlocked;
    if (seatSteerer) seatSteerer.disabled = editBlocked;
    if (seatRefresh) seatRefresh.disabled = seatSaving || seatPublishing || unresolved || !managedPractice;
    if (seatRemove) seatRemove.disabled = editBlocked || !Boolean(selectedDraftSeat());
    if (seatUndo) seatUndo.disabled = editBlocked || !seatHistory.length;
    if (seatReset) {
      seatReset.disabled = seatSaving || seatPublishing || unresolved || !managedSeating
        || (seatServerConflict ? !seatConflictServerReady : !managedSeating.editable);
      seatReset.textContent = seatServerConflict
        ? (seatConflictServerReady ? "采用服务器草稿" : "请先刷新服务器草稿")
        : "从正式版重置草稿";
    }
    if (seatSave) seatSave.disabled = editBlocked || seatSaving || !seatDirty;
    if (seatPublish) seatPublish.disabled = editBlocked || seatSaving || seatDirty;
    if (seatRetry) {
      seatRetry.hidden = !seatPendingPayload || (!seatOutcomeUnknown && !seatPendingAccepted);
      seatRetry.disabled = seatSaving || seatPublishing || !sessionToken;
      seatRetry.textContent = seatPendingAccepted ? "重新读取已保存排座"
        : seatPendingAction === "publishSeatPlan" ? "按原版本重试发布" : "按原草稿重试并确认结果";
    }
    updateP2Controls(false);
  }

  function buildSeatDraftPayload(changeKind = "EDIT") {
    if (!managedSeating || !localSeatDraft || !managedPractice) return null;
    return {
      season_id: p2SeasonId,
      practice_id: managedPractice.practice.practice_id,
      practice_version: managedPractice.practice.practice_version,
      signup_version: managedPractice.signup_version,
      seat_plan_version: managedSeating.seat_plan_version,
      published_revision: managedSeating.published_revision || 0,
      coach_member_id: localSeatDraft.coach_member_id,
      steerer_member_id: localSeatDraft.steerer_member_id,
      seats: localSeatDraft.seats.map((item: any) => ({ ...item })),
      change_kind: changeKind
    };
  }

  function updateFromSeatResponse(data: any, sentSequence: number) {
    const workspaceData = data?.seating || data;
    const expectedPracticeId = managedPractice?.practice?.practice_id;
    if (!workspaceData?.draft || workspaceData.practice_id !== expectedPracticeId
        || !Number.isInteger(Number(workspaceData.seat_plan_version))) {
      throw new DragonBoatApiError("INVALID_RESPONSE", "服务器返回的排座视图不完整。", { retryable: true });
    }
    if (data?.practice && Array.isArray(data?.signups)) {
      managedPractice = {
        ...managedPractice,
        practice: data.practice,
        signup_version: data.signup_version,
        signups: data.signups,
        counts: data.counts || managedPractice?.counts,
        signup_open: data.signup_open ?? managedPractice?.signup_open,
        management_signup_open: data.management_signup_open ?? managedPractice?.management_signup_open,
        closed_reason: data.closed_reason || managedPractice?.closed_reason,
        seat_plan: data.seat_plan || managedPractice?.seat_plan,
        generated_at: data.generated_at || new Date().toISOString()
      };
      renderManagedPractice({ practiceId: data.practice.practice_id });
    } else if (managedPractice && workspaceData?.published) {
      managedPractice.seat_plan = workspaceData.published;
    }
    managedSeating = workspaceData;
    if (sentSequence === seatEditSequence) {
      localSeatDraft = cloneSeatDraft(workspaceData.draft);
      seatDirty = false;
      seatServerConflict = false;
      seatConflictServerReady = false;
    }
    renderSeatEditor();
  }

  function clearSeatPending() {
    seatPendingAction = "";
    seatPendingPayload = null;
    seatPendingKey = "";
    seatPendingSequence = -1;
    seatPendingAccepted = false;
    seatOutcomeUnknown = false;
  }

  function seatRequestContextMatches(token: string, practiceId: string) {
    return Boolean(token && token === sessionToken && practiceId
      && practiceId === managedPractice?.practice?.practice_id);
  }

  async function submitSeatRequest(action: string, payload: Record<string, any>, key: string, sentSequence: number, retryExisting = false) {
    const token = sessionToken;
    const practiceId = String(payload.practice_id || "");
    if (!retryExisting) {
      seatPendingAction = action;
      seatPendingPayload = structuredClone(payload);
      seatPendingKey = key;
      seatPendingSequence = sentSequence;
      seatPendingAccepted = false;
      seatOutcomeUnknown = false;
    } else {
      action = seatPendingAction;
      payload = seatPendingPayload || payload;
      key = seatPendingKey;
      sentSequence = seatPendingSequence;
    }
    if (!seatRequestContextMatches(token, practiceId)) return false;
    action === "publishSeatPlan" ? seatPublishing = true : seatSaving = true;
    updateSeatControls();
    try {
      let responseData;
      if (seatPendingAccepted) {
        const response = await client!.post("getSeatingWorkspace", {
          session_token: token, season_id: p2SeasonId, practice_id: practiceId
        });
        responseData = response.data;
      } else {
        const response = await managedPost(action, payload, key);
        if (!seatRequestContextMatches(token, practiceId)) return false;
        seatPendingAccepted = true;
        seatOutcomeUnknown = false;
        responseData = response.data;
      }
      if (!seatRequestContextMatches(token, practiceId)) return false;
      updateFromSeatResponse(responseData, sentSequence);
      const newerEditsRemain = sentSequence < seatEditSequence && seatDirty;
      const publishedRevision = responseData.published_revision ?? responseData.seating?.published_revision ?? managedSeating?.published_revision;
      clearSeatPending();
      // The response render happened while the accepted-write guard was still
      // active. Render once more after clearing it so dynamic pool/seat buttons
      // reflect the same unlocked state as the static controls.
      renderSeatEditor();
      setStatus(seatStatus, action === "publishSeatPlan"
        ? `正式座位表已发布为 revision ${publishedRevision}。`
        : newerEditsRemain ? "较早的草稿版本已保存；刚才继续做出的调整即将自动保存。" : "私有排座草稿已由服务器保存。", newerEditsRemain ? "pending" : "ready");
      return true;
    } catch (error) {
      if (!seatRequestContextMatches(token, practiceId) || protectedError(error)) return false;
      if (seatPendingAccepted) {
        seatOutcomeUnknown = false;
        setStatus(seatStatus, `服务器已经确认写入，但最新排座读取失败。请点击「重新读取已保存排座」，不会再次发送写入。${messageForError(error)}`, "error");
        return false;
      }
      const uncertain = !(error instanceof DragonBoatApiError) || error.retryable || ["INVALID_RESPONSE", "CONTRACT_MISMATCH"].includes(error.code);
      if (uncertain) {
        seatOutcomeUnknown = true;
      } else {
        clearSeatPending();
        if (error instanceof DragonBoatApiError && error.code === "VERSION_CONFLICT") {
          seatServerConflict = true;
          seatConflictServerReady = false;
          renderSeatEditor();
        }
      }
      setStatus(seatStatus, uncertain
        ? `${messageForError(error)} 结果尚未确认，原草稿和请求编号已经锁定，请使用下方重试。`
        : error instanceof DragonBoatApiError && error.code === "VERSION_CONFLICT"
          ? `${messageForError(error)} 本地草稿仍保留。请先刷新排座；读取最新服务器草稿后才可选择采用。`
          : `${messageForError(error)} 本地草稿仍保留，请按提示处理或刷新。`, "error");
      return false;
    } finally {
      if (seatRequestContextMatches(token, practiceId)) {
        seatSaving = false;
        seatPublishing = false;
        updateSeatControls();
        if (!seatPendingPayload && seatDirty && sentSequence < seatEditSequence && !seatServerConflict) scheduleSeatSave("EDIT");
      }
    }
  }

  async function saveSeatDraft(changeKind = "EDIT") {
    if (seatSaveTimer !== undefined) window.clearTimeout(seatSaveTimer);
    seatSaveTimer = undefined;
    if (!seatDirty || seatSaving || seatPublishing || seatPendingPayload || seatServerConflict) return false;
    const payload = buildSeatDraftPayload(changeKind);
    if (!payload) return false;
    const sentSequence = seatEditSequence;
    return submitSeatRequest("saveSeatPlanDraft", payload,
      `seat-draft:${payload.practice_id}:${payload.seat_plan_version}`, sentSequence);
  }

  async function refreshSeating(preserveLocal = true) {
    if (!client || !sessionToken || !p2SeasonId || !managedPractice || seatSaving || seatPublishing || seatOutcomeUnknown || seatPendingAccepted) return false;
    const token = sessionToken;
    const practiceId = managedPractice.practice.practice_id;
    const revision = ++seatReadVersion;
    const local = preserveLocal && localSeatDraft ? cloneSeatDraft(localSeatDraft) : null;
    const baseVersionKey = seatWorkspaceVersionKey(managedSeating);
    setStatus(seatStatus, "正在读取服务器最新排座……", "pending");
    try {
      const response = await client.post("getSeatingWorkspace", {
        session_token: token, season_id: p2SeasonId, practice_id: practiceId
      });
      if (!seatRequestContextMatches(token, practiceId) || revision !== seatReadVersion
          || response.data.practice?.practice_id !== practiceId) return false;
      if (local && seatDirty && (seatServerConflict || seatWorkspaceVersionKey(response.data) !== baseVersionKey)) {
        managedSeating = response.data;
        localSeatDraft = local;
        seatServerConflict = true;
        seatConflictServerReady = true;
        renderSeatEditor();
        setStatus(seatStatus, "服务器已有更新，本地草稿已保留。请选择采用服务器草稿后再重新安排。", "error");
      } else {
        updateFromSeatResponse(response.data, seatEditSequence);
        seatConflictServerReady = false;
        setStatus(seatStatus, "已读取服务器最新排座。", "ready");
      }
      return true;
    } catch (error) {
      if (seatRequestContextMatches(token, practiceId) && revision === seatReadVersion && !protectedError(error)) {
        setStatus(seatStatus, messageForError(error), "error");
      }
      return false;
    }
  }

  function renderManagedSignupMemberPicker(preferred = "") {
    if (!managedSignupMember) return;
    const query = managedSignupSearch?.value.trim().toLocaleLowerCase() || "";
    const matches = managedMembers.filter((member) => member.display_name.toLocaleLowerCase().includes(query));
    const empty = document.createElement("option");
    empty.value = "";
    empty.textContent = matches.length ? "请选择要操作的队员" : "没有匹配队员";
    managedSignupMember.replaceChildren(empty, ...matches.map((member) => {
      const signup = managedPractice?.signups?.find((item: any) => item.member_id === member.member_id);
      const option = document.createElement("option");
      option.value = member.member_id;
      option.textContent = `${member.display_name} · ${signup ? signup.status === "CANCELLED" ? "已取消" : signup.status === "WAITLISTED" ? "候补" : "已确认" : "未报名"}${member.status === "INACTIVE" ? " · 已停用" : ""} · ${String(member.member_id).slice(-6)}`;
      return option;
    }));
    managedSignupMember.value = matches.some((member) => member.member_id === preferred) ? preferred : "";
  }

  function renderManagedSignupSelection(preference = "") {
    const member = managedMembers.find((item) => item.member_id === managedSignupMember?.value);
    const signup = currentManagedSignup();
    const active = signup && signup.status !== "CANCELLED";
    const preferenceInput = managedSignupForm?.elements.namedItem("preference") as HTMLSelectElement | null;
    if (preferenceInput) preferenceInput.value = preference || signup?.preference || member?.default_preference || "AMBIENT";
    if (managedSignupCurrent) managedSignupCurrent.textContent = !member ? "请先选择队员。" : signup
      ? `${member.display_name}：${signupResultText(signup)}${signup.queue_at ? ` · 原报名时间 ${new Date(signup.queue_at).toLocaleString()}` : ""}`
      : `${member.display_name} 尚未报名。`;
    if (managedSignupSubmit) managedSignupSubmit.textContent = active ? "保存本次偏好" : signup?.status === "CANCELLED" ? "按新时间重新报名" : "代为报名";
    if (managedSignupCancelArea) managedSignupCancelArea.hidden = !active;
    if (managedSignupCancelConfirm) managedSignupCancelConfirm.checked = false;
    if (managedSignupCancelText) managedSignupCancelText.textContent = member ? `确认取消「${member.display_name}」的本次报名；重新报名将使用新时间排队。` : "";
    if (managedSignupPreview) managedSignupPreview.textContent = active
      ? "直接修改偏好保留原报名时间。放弃的原侧名额可能由候补递补，换回原侧不保证有位；目标侧没有名额时加入候补。"
      : "报名成功后，服务器决定确认或候补及实际排队位置；已取消后重新报名使用新时间。";
    updateP2Controls();
  }

  async function startP2Mutation(kind: "member" | "signup", action: string, payload: Record<string, any>) {
    if (p2Busy || p2Pending || p2Refreshing || managementWriting || seatContextNeedsResolution()
        || !sessionToken || !membersFresh || (kind === "signup" && !practiceFresh)) return;
    p2Pending = { kind, action, payload: structuredClone({ ...payload, include_current_view: true,
      known_roster_version: managedRosterVersion, view_practice_id: managedPracticePicker?.value || "" }),
      requestId: createRequestId(), draft: captureP2Draft() };
    await runP2Mutation();
  }

  async function runP2Mutation() {
    if (!client || !sessionToken || !p2Pending || p2Busy) return;
    const pending = p2Pending;
    const token = sessionToken;
    const status = pending.kind === "member" ? memberEditStatus : managedSignupStatus;
    const draft = pending.draft;
    p2Busy = true;
    updateP2Controls();
    setStatus(status, pending.accepted ? "正在重新读取已保存结果，不会再次写入……" : "正在提交并等待服务器确认，请勿重复操作……", "pending");
    try {
      if (!pending.accepted) {
        const response = await client.post(pending.action, { ...pending.payload, session_token: token }, { requestId: pending.requestId });
        if (token !== sessionToken || p2Pending !== pending) return;
        pending.result = response.data;
        pending.accepted = true;
      }
      const resultDraft = pending.kind === "signup" ? { ...draft, preference: "", signupMemberId: pending.payload.member_id }
        : { ...draft, memberFields: null, memberId: pending.payload.member_id };
      if (pending.result?.view_status !== "ready" || !applyManagedView(pending.result.current_view, resultDraft)) {
        setStatus(status, "服务器已确认保存，正在重新读取名册与报名……", "pending");
        await loadManagedMembers(pending.kind === "signup" ? draft : { memberId: pending.payload.member_id });
        await loadManagedPractice(pending.kind === "signup" ? { signupMemberId: pending.payload.member_id } : draft);
      }
      if (token !== sessionToken || p2Pending !== pending) return;
      p2Pending = null;
      if (pending.kind === "member") {
        const latest = managedMembers.find((member) => member.member_id === pending.payload.member_id);
        setStatus(status, pending.action === "restoreMemberName" ? `恢复姓名操作已保存。当前显示姓名：${latest?.display_name || "未找到成员"}，报名关联保持不变。` : pending.action === "setMemberStatus" ? `状态操作已保存。当前状态：${latest?.status === "ACTIVE" ? "有效" : "已停用"}，名单版本已更新。` : "队员资料已保存，下方名册与报名已按服务器当前视图更新。", "ready");
      } else {
        const result = pending.result;
        const promotedNames = (result.promoted_member_ids || []).map((id: string) => managedMembers.find((member) => member.member_id === id)?.display_name || id);
        const latest = managedPractice?.signups?.find((signup: any) => signup.member_id === pending.payload.member_id);
        setStatus(status, `操作已保存。当前状态：${signupResultText(latest || { status: "CANCELLED" })}${promotedNames.length ? ` 本次操作曾触发递补：${promotedNames.join("、")}；当前状态以清单为准。` : " 本次没有其他队员递补。"} 清单已按服务器当前视图更新。`, "ready");
      }
    } catch (error) {
      if (token !== sessionToken || p2Pending !== pending) return;
      if (protectedError(error)) return;
      if (pending.accepted) {
        setStatus(status, `服务器已确认保存成功，但最新清单读取失败。请点击「重新读取已保存结果」，不会再次写入。${messageForError(error)}`, "error");
        return;
      }
      const uncertain = !(error instanceof DragonBoatApiError) || error.retryable || ["INVALID_RESPONSE", "CONTRACT_MISMATCH"].includes(error.code);
      if (uncertain) {
        setStatus(status, `${messageForError(error)} 操作结果尚未确认，原内容和请求编号已锁定。请点击下方重试按钮，不要刷新或重新提交。`, "error");
      } else {
        p2Pending = null;
        try {
          await loadManagedMembers(draft);
          await loadManagedPractice(draft);
          if (!sessionToken) return;
          setStatus(status, `${messageForError(error)} 已刷新服务器状态并保留输入，请核对后重新确认。`, "error");
        } catch (refreshError) {
          if (!protectedError(refreshError)) setStatus(status, `${messageForError(error)} 刷新未完成，当前信息可能已过期，请先刷新。`, "error");
        }
      }
      return;
    } finally {
      if (token === sessionToken) {
        p2Busy = false;
        updateP2Controls();
      }
    }
  }

  function addTemplateRow(template: any = {}) {
    if (!templateRows) return;
    const row = document.createElement("div");
    row.className = "dragon-boat-template-row";
    const fields = [
      ["day_of_week", "星期", "select"],
      ["start_time", "开始", "time"],
      ["end_time", "结束", "time"],
      ["location", "地点", "text"],
      ["address", "地址", "text"],
      ["map_url", "地图链接", "url"]
    ];
    fields.forEach(([name, labelText, type]) => {
      const label = document.createElement("label");
      label.textContent = labelText;
      let input: HTMLInputElement | HTMLSelectElement;
      if (type === "select") {
        input = document.createElement("select");
        ["周一", "周二", "周三", "周四", "周五", "周六", "周日"].forEach((label, index) => {
          const option = document.createElement("option");
          option.value = String(index + 1);
          option.textContent = label;
          input.append(option);
        });
      } else {
        input = document.createElement("input");
        input.type = type;
      }
      input.name = name;
      input.required = name !== "map_url";
      input.value = String(template[name] || (name === "day_of_week" ? 3 : ""));
      label.append(input);
      row.append(label);
    });
    const remove = document.createElement("button");
    remove.type = "button";
    remove.className = "dragon-boat-text-button";
    remove.textContent = "移除";
    remove.addEventListener("click", () => row.remove());
    row.append(remove);
    templateRows.append(row);
  }

  function renderTemplates(templates: any[]) {
    if (!templateRows) return;
    templateRows.replaceChildren();
    if (templates.length) templates.forEach(addTemplateRow);
    else {
      addTemplateRow({ day_of_week: 3, start_time: "18:00", end_time: "20:00" });
      addTemplateRow({ day_of_week: 6, start_time: "10:00", end_time: "12:00" });
    }
  }

  function renderAdminWeeks(weeks: any[]) {
    if (!adminWeekList || !additionalWeek) return;
    adminWeekList.replaceChildren();
    additionalWeek.replaceChildren();
    const openedWeeks = weeks.filter((item) => item.week.status === "OPENED");
    if (!weeks.length) {
      const empty = document.createElement("p");
      empty.className = "dragon-boat-empty-state";
      empty.textContent = "尚未生成周草稿。";
      adminWeekList.append(empty);
    }
    weeks.forEach((item) => {
      const card = document.createElement("section");
      card.className = "dragon-boat-admin-week-card";
      const heading = document.createElement("div");
      heading.className = "dragon-boat-section-heading";
      const title = document.createElement("h4");
      title.textContent = `${item.week.week_start_date} · ${item.week.status} · v${item.week.week_version}`;
      heading.append(title);
      if (item.week.status === "DRAFT") {
        const publish = document.createElement("button");
        publish.type = "button";
        publish.className = "dragon-boat-primary-button";
        publish.textContent = "确认并立即开放整周";
        publish.addEventListener("click", () => confirmWeek(item.week));
        heading.append(publish);
      }
      const practices = document.createElement("ul");
      item.practices.forEach((practice: any) => {
        const line = document.createElement("li");
        const text = document.createElement("span");
        text.textContent = `${new Date(practice.start_at).toLocaleString()} · ${practice.location} · ${practice.schedule_published_at ? "已公开" : "私有草稿"}`;
        line.append(text);
        if (item.week.status === "OPENED" && !practice.schedule_published_at) {
          const publish = document.createElement("button");
          publish.type = "button";
          publish.className = "dragon-boat-text-button";
          publish.textContent = "单独发布这次加场";
          publish.addEventListener("click", () => publishAdditional(item.week, practice));
          line.append(publish);
        }
        practices.append(line);
      });
      card.append(heading, practices);
      adminWeekList.append(card);
    });
    openedWeeks.forEach((item) => {
      const option = document.createElement("option");
      option.value = item.week.week_id;
      option.textContent = item.week.week_start_date;
      option.dataset.weekVersion = String(item.week.week_version);
      additionalWeek.append(option);
    });
    if (additionalForm) {
      additionalForm.querySelectorAll("input, select, button").forEach((control: any) => {
        control.disabled = !openedWeeks.length;
      });
    }
  }

  async function confirmWeek(week: any) {
    if (!currentSeasonData) return;
    setStatus(managementStatus, "正在确认并开放整周……", "pending");
    try {
      await managedPost("confirmTrainingWeek", {
        season_id: currentSeasonData.season.season_id,
        week_id: week.week_id,
        week_version: week.week_version
      }, `confirm:${week.week_id}:${week.week_version}`);
      await loadSeason(currentSeasonData.season.season_id);
      setStatus(managementStatus, "整周训练已经正式开放。", "ready");
    } catch (error) {
      if (!protectedError(error)) setStatus(managementStatus, messageForError(error), "error");
    }
  }

  async function publishAdditional(week: any, practice: any) {
    if (!currentSeasonData) return;
    setStatus(managementStatus, "正在单独发布加场……", "pending");
    try {
      await managedPost("publishAdditionalPractice", {
        season_id: currentSeasonData.season.season_id,
        week_id: week.week_id,
        practice_id: practice.practice_id,
        week_version: week.week_version,
        practice_version: practice.practice_version
      }, `publish-additional:${practice.practice_id}:${practice.practice_version}`);
      await loadSeason(currentSeasonData.season.season_id);
      setStatus(managementStatus, "这次加场已经单独发布，其他草稿没有公开。", "ready");
    } catch (error) {
      if (!protectedError(error)) setStatus(managementStatus, messageForError(error), "error");
    }
  }

  memberSearch?.addEventListener("input", () => {
    renderMemberPicker(memberPicker?.value);
    renderMemberDetail();
    setStatus(memberEditStatus, "");
  });
  memberPicker?.addEventListener("change", () => {
    renderMemberDetail();
    setStatus(memberEditStatus, "");
  });
  memberEditForm?.addEventListener("input", renderMemberPreview);
  memberStatusConfirm?.addEventListener("change", () => updateP2Controls());
  memberEditForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const member = currentMember();
    if (!member || !p2SeasonId) return;
    startP2Mutation("member", "updateMember", {
      season_id: p2SeasonId,
      member_id: member.member_id,
      member_version: member.member_version,
      ...memberInputValues()
    });
  });
  memberRestore?.addEventListener("click", () => {
    const member = currentMember();
    if (!member?.display_name_override || !p2SeasonId) return;
    startP2Mutation("member", "restoreMemberName", {
      season_id: p2SeasonId,
      member_id: member.member_id,
      member_version: member.member_version
    });
  });
  memberStatusButton?.addEventListener("click", () => {
    const member = currentMember();
    if (!member || !p2SeasonId || !memberStatusConfirm?.checked || (member.status === "ACTIVE" && member.active_links?.length)) return;
    startP2Mutation("member", "setMemberStatus", {
      season_id: p2SeasonId,
      member_id: member.member_id,
      member_version: member.member_version,
      status: member.status === "ACTIVE" ? "INACTIVE" : "ACTIVE"
    });
  });
  memberRetry?.addEventListener("click", runP2Mutation);
  managedSignupRetry?.addEventListener("click", runP2Mutation);
  memberRefresh?.addEventListener("click", async () => {
    if (p2Busy || p2Pending || p2Refreshing) return;
    const draft = captureP2Draft();
    const token = sessionToken;
    p2Refreshing = true;
    updateP2Controls();
    setStatus(memberConsoleStatus, "正在刷新名册与报名……", "pending");
    try {
      await readMemberWorkspace(draft, true);
      if (token === sessionToken) setStatus(memberConsoleStatus, "已刷新服务器状态，未提交输入保留，请核对后再保存。", "ready");
    } catch (error) {
      if (token !== sessionToken) return;
      if (!protectedError(error)) setStatus(memberConsoleStatus, `刷新失败，当前信息可能已过期。${messageForError(error)}`, "error");
    } finally {
      if (token === sessionToken) {
        p2Refreshing = false;
        updateP2Controls();
      }
    }
  });
  async function refreshSelectedPractice(preserveInput: boolean) {
    if (p2Busy || p2Pending || p2Refreshing) return;
    if (!preserveInput && seatContextNeedsResolution()) {
      if (managedPracticePicker && managedPractice?.practice?.practice_id) managedPracticePicker.value = managedPractice.practice.practice_id;
      setStatus(seatStatus, "当前排座仍有未保存、待确认或冲突内容。请先完成排座处理，再切换训练。", "error");
      return;
    }
    const draft = preserveInput ? captureP2Draft() : null;
    const token = sessionToken;
    p2Refreshing = true;
    updateP2Controls();
    if (!preserveInput) {
      if (seatSaveTimer !== undefined) window.clearTimeout(seatSaveTimer);
      seatSaveTimer = undefined;
      seatReadVersion += 1;
      managedPractice = null;
      managedSeating = null;
      localSeatDraft = null;
      seatSelectedMemberId = "";
      seatHistory = [];
      seatDirty = false;
      seatServerConflict = false;
      seatConflictServerReady = false;
      if (seatConsole) seatConsole.hidden = true;
      if (managedPracticeDetail) managedPracticeDetail.hidden = true;
      if (managedSignupSearch) managedSignupSearch.value = "";
      if (managedSignupMember) managedSignupMember.value = "";
      setStatus(managedSignupStatus, "");
    }
    try {
      await readMemberWorkspace(draft, preserveInput);
    } catch (error) {
      if (token !== sessionToken) return;
      if (!protectedError(error)) setStatus(managedPracticeStatus, `读取失败，当前信息可能已过期。${messageForError(error)}`, "error");
    } finally {
      if (token === sessionToken) {
        p2Refreshing = false;
        updateP2Controls();
      }
    }
  }
  managedPracticePicker?.addEventListener("change", () => refreshSelectedPractice(false));
  managedPracticeRefresh?.addEventListener("click", () => refreshSelectedPractice(true));
  managedSignupSearch?.addEventListener("input", () => {
    renderManagedSignupMemberPicker(managedSignupMember?.value);
    renderManagedSignupSelection();
  });
  managedSignupMember?.addEventListener("change", () => {
    renderManagedSignupSelection();
    setStatus(managedSignupStatus, "");
  });
  managedSignupCancelConfirm?.addEventListener("change", () => updateP2Controls());
  function managedSignupPayload() {
    if (!managedPractice || !p2SeasonId || !managedSignupMember?.value || !managedPractice.management_signup_open) return null;
    return {
      season_id: p2SeasonId,
      practice_id: managedPractice.practice.practice_id,
      member_id: managedSignupMember.value,
      practice_version: managedPractice.practice.practice_version,
      signup_version: managedPractice.signup_version
    };
  }
  managedSignupForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const payload = managedSignupPayload();
    if (!payload) return;
    const member = managedMembers.find((item) => item.member_id === payload.member_id);
    if (member?.status !== "ACTIVE") return;
    const signup = currentManagedSignup();
    const preference = (managedSignupForm.elements.namedItem("preference") as HTMLSelectElement).value;
    startP2Mutation("signup", signup && signup.status !== "CANCELLED" ? "updateSignupByCoach" : "signupByCoach", { ...payload, preference });
  });
  managedSignupCancel?.addEventListener("click", () => {
    const payload = managedSignupPayload();
    if (!payload || !managedSignupCancelConfirm?.checked || currentManagedSignup()?.status === "CANCELLED") return;
    startP2Mutation("signup", "cancelSignupByCoach", payload);
  });

  function changeSeatRole(field: "coach_member_id" | "steerer_member_id", value: string) {
    if (!localSeatDraft || seatEditBlocked()) return;
    if (localSeatDraft[field] === value) return;
    const before = cloneSeatDraft(localSeatDraft);
    localSeatDraft[field] = value;
    if (value) localSeatDraft.seats = localSeatDraft.seats.filter((item: any) => item.member_id !== value);
    seatHistory.push(before);
    if (seatHistory.length > 20) seatHistory.shift();
    seatSelectedMemberId = "";
    markSeatDirty("EDIT");
  }

  seatCoach?.addEventListener("change", () => changeSeatRole("coach_member_id", seatCoach.value));
  seatSteerer?.addEventListener("change", () => changeSeatRole("steerer_member_id", seatSteerer.value));
  seatRemove?.addEventListener("click", () => {
    const source = selectedDraftSeat();
    if (!source || !localSeatDraft || seatEditBlocked()) return;
    seatHistory.push(cloneSeatDraft(localSeatDraft));
    if (seatHistory.length > 20) seatHistory.shift();
    localSeatDraft.seats = localSeatDraft.seats.filter((item: any) => item.member_id !== seatSelectedMemberId);
    seatSelectedMemberId = "";
    markSeatDirty("EDIT");
  });
  seatUndo?.addEventListener("click", () => {
    const previous = seatHistory.pop();
    if (!previous || seatEditBlocked()) return;
    localSeatDraft = cloneSeatDraft(previous);
    seatSelectedMemberId = "";
    markSeatDirty("UNDO");
  });
  seatReset?.addEventListener("click", () => {
    if (!managedSeating || seatSaving || seatPublishing || seatOutcomeUnknown || seatPendingAccepted) return;
    if (seatServerConflict) {
      if (!seatConflictServerReady) return;
      localSeatDraft = cloneSeatDraft(managedSeating.draft);
      seatDirty = false;
      seatServerConflict = false;
      seatConflictServerReady = false;
      seatHistory = [];
      seatSelectedMemberId = "";
      renderSeatEditor();
      setStatus(seatStatus, "已采用服务器草稿。本地冲突版本没有提交。", "ready");
      return;
    }
    if (!managedSeating.editable || !localSeatDraft) return;
    seatHistory.push(cloneSeatDraft(localSeatDraft));
    const published = managedSeating.published;
    localSeatDraft = cloneSeatDraft(published ? {
      coach_member_id: published.coach?.member_id || "",
      steerer_member_id: published.steerer?.member_id || "",
      seats: published.seats || []
    } : { seats: [] });
    seatSelectedMemberId = "";
    markSeatDirty("RESET_TO_PUBLISHED");
  });
  seatSave?.addEventListener("click", () => saveSeatDraft("EDIT"));
  seatRefresh?.addEventListener("click", () => refreshSeating(true));
  seatRetry?.addEventListener("click", async () => {
    if (!seatPendingPayload || !seatPendingAction || !seatPendingKey || seatSaving || seatPublishing) return;
    await submitSeatRequest(seatPendingAction, seatPendingPayload, seatPendingKey, seatPendingSequence, true);
  });
  seatPublish?.addEventListener("click", async () => {
    if (!managedSeating?.editable || !managedPractice || seatSaving || seatPublishing || seatPendingPayload || seatServerConflict) return;
    if (seatDirty) {
      const saved = await saveSeatDraft("EDIT");
      if (!saved || seatDirty || seatPendingPayload) return;
    }
    const mismatches = managedSeating.preference_mismatches || [];
    const acknowledged = mismatches.length > 0
      ? window.confirm(`有 ${mismatches.length} 位队员的明确左右偏好与船位不同。确认仍按当前草稿发布吗？`)
      : false;
    if (mismatches.length && !acknowledged) {
      setStatus(seatStatus, "发布已取消，草稿保持不变。", "pending");
      return;
    }
    const payload = {
      season_id: p2SeasonId,
      practice_id: managedPractice.practice.practice_id,
      practice_version: managedPractice.practice.practice_version,
      signup_version: managedPractice.signup_version,
      seat_plan_version: managedSeating.seat_plan_version,
      published_revision: managedSeating.published_revision || 0,
      acknowledge_preference_mismatch: acknowledged
    };
    await submitSeatRequest("publishSeatPlan", payload,
      `seat-publish:${payload.practice_id}:${payload.seat_plan_version}:${payload.published_revision}`, seatEditSequence);
  });

  loginForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!client || !codeInput || loginInProgress) return;
    const coachCode = codeInput.value;
    codeInput.value = "";
    loginInProgress = true;
    if (loginButton) loginButton.disabled = true;
    setStatus(loginStatus, "正在验证……", "pending");
    try {
      const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(coachCode));
      const codeDigest = Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("");
      if (!pendingLogin || pendingLogin.codeDigest !== codeDigest) {
        pendingLogin = { codeDigest, requestId: createRequestId() };
      }
      const response = await client.post("coachLogin", { coach_code: coachCode }, { requestId: pendingLogin.requestId });
      if (typeof response.data?.session_token !== "string" || !response.data.session_token
        || !Number.isFinite(Date.parse(response.data?.session?.expires_at))) {
        throw new DragonBoatApiError("INVALID_RESPONSE", "登录响应不完整，暂时无法确认结果。", { retryable: true });
      }
      sessionToken = response.data.session_token;
      saveCoachSession(sessionToken, response.data.session);
      pendingLogin = null;
      if (loginPanel) loginPanel.hidden = true;
      if (workspace) workspace.hidden = false;
      setStatus(loginStatus, "");
      try {
        await refreshBootstrap();
      } catch (error) {
        if (!protectedError(error)) setStatus(managementStatus,
          `登录已成功，但赛季入口读取失败。请点击「刷新」，无需重新登录。${messageForError(error)}`, "error");
      }
    } catch (error) {
      const uncertain = !(error instanceof DragonBoatApiError) || error.retryable || ["INVALID_RESPONSE", "CONTRACT_MISMATCH"].includes(error.code);
      if (!uncertain) pendingLogin = null;
      clearCoachSession();
      showLogin(`${messageForError(error)}${pendingLogin
        ? " 请重新输入相同 Coach Code 后登录；本页会沿用原请求确认结果。"
        : " 请重新输入 Coach Code 后登录。"}`);
    } finally {
      loginInProgress = false;
      if (loginButton) loginButton.disabled = false;
    }
  });

  logoutButton?.addEventListener("click", async () => {
    const token = sessionToken;
    pendingLogin = null;
    clearCoachSession();
    showLogin("本机已退出 Coach Mode。", "ready");
    if (!client || !token) return;
    try {
      await client.post("coachLogout", { session_token: token });
      setStatus(loginStatus, "已退出 Coach Mode。", "ready");
    } catch {
      setStatus(loginStatus, "本机已退出；后端会话将在到期后自动失效。", "pending");
    }
  });

  refreshButton?.addEventListener("click", () => refreshBootstrap(seasonPicker?.value).catch((error) => {
    if (!protectedError(error)) setStatus(managementStatus, messageForError(error), "error");
  }));
  managementRetry?.addEventListener("click", async () => {
    const entry = [...pendingRequests.entries()][0];
    if (!entry || managementWriting || !sessionToken) return;
    setStatus(managementStatus, "正在按上次提交的原内容确认结果，当前修改不会发送……", "pending");
    try {
      const [key, request] = entry;
      const response = await managedPost(request.action, request.payload, key);
      if (request.action === "createSeason") {
        createSeasonForm?.reset();
        if (createSeasonDetails) createSeasonDetails.open = false;
      }
      if (request.action === "createPractice") additionalForm?.reset();
      await refreshBootstrap(response.data.season?.season_id || String(request.payload.season_id || ""));
      setStatus(managementStatus, "原操作已由服务器确认成功，已重新读取赛季。请核对结果后再进行新的修改。", "ready");
    } catch (error) {
      if (!protectedError(error)) setStatus(managementStatus, messageForError(error), "error");
    }
  });
  seasonPicker?.addEventListener("change", () => { seasonReadVersion++; clearSeasonView(); updateP2Controls(); });
  openSeason?.addEventListener("click", () => loadSeason(seasonPicker?.value || ""));
  openMembers?.addEventListener("click", () => loadP2Season());

  createSeasonForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    setStatus(managementStatus, "正在建立赛季草稿……", "pending");
    try {
      const response = await managedPost("createSeason", formObject(createSeasonForm), "create-season");
      createSeasonForm.reset();
      const timezone = createSeasonForm.elements.namedItem("timezone") as HTMLInputElement;
      if (timezone) timezone.value = "America/New_York";
      if (createSeasonDetails) createSeasonDetails.open = false;
      await refreshBootstrap(response.data.season.season_id);
      setStatus(managementStatus, "赛季草稿已建立。请继续检查 Form 和响应表连接。", "ready");
    } catch (error) {
      if (!protectedError(error)) setStatus(managementStatus, messageForError(error), "error");
    }
  });

  bindingForm?.addEventListener("input", () => {
    bindingValidated = false;
    if (initializeButton) initializeButton.disabled = true;
  });
  bindingForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!client || !sessionToken || !currentSeasonData) return;
    setStatus(bindingStatus, "正在只读检查 Form、响应目标、Tab 和姓名列……", "pending");
    try {
      const response = await client.post("validateSeasonBinding", {
        session_token: sessionToken,
        season_id: currentSeasonData.season.season_id,
        ...formObject(bindingForm)
      });
      bindingValidated = true;
      if (initializeButton) initializeButton.disabled = false;
      const preview = response.data.preview_names.length ? `；预览：${response.data.preview_names.join("、")}` : "";
      setStatus(bindingStatus, `连接检查通过，共有 ${response.data.response_count} 条现有回答${preview}。`, "ready");
    } catch (error) {
      bindingValidated = false;
      if (initializeButton) initializeButton.disabled = true;
      if (!protectedError(error)) setStatus(bindingStatus, messageForError(error), "error");
    }
  });
  initializeButton?.addEventListener("click", async () => {
    if (!bindingValidated || !bindingForm || !currentSeasonData) return;
    setStatus(bindingStatus, "正在建立系统 Tab、导入名单并安装同步触发器……", "pending");
    try {
      const season = currentSeasonData.season;
      const response = await managedPost("initializeSeason", {
        season_id: season.season_id,
        season_version: season.season_version,
        ...formObject(bindingForm)
      }, `initialize:${season.season_id}:${season.season_version}`);
      await refreshBootstrap(response.data.season.season_id);
      setStatus(managementStatus, `赛季已自动激活，导入 ${response.data.sync.imported_count} 名队员。`, "ready");
    } catch (error) {
      if (!protectedError(error)) setStatus(bindingStatus, messageForError(error), "error");
    }
  });

  syncButton?.addEventListener("click", async () => {
    if (!currentSeasonData) return;
    setStatus(managementStatus, "正在检查新的表单回答……", "pending");
    try {
      const seasonId = currentSeasonData.season.season_id;
      const response = await managedPost("retrySeasonSync", { season_id: seasonId }, `sync:${seasonId}`);
      await loadSeason(seasonId);
      setStatus(managementStatus, `同步完成，新增 ${response.data.sync.imported_count} 名队员。`, "ready");
    } catch (error) {
      if (!protectedError(error)) setStatus(managementStatus, messageForError(error), "error");
    }
  });

  addTemplateButton?.addEventListener("click", () => addTemplateRow());
  templateForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!currentSeasonData || !templateRows) return;
    const templates = [...templateRows.querySelectorAll<HTMLElement>(".dragon-boat-template-row")].map((row) => {
      const values: Record<string, string | number> = {};
      row.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select").forEach((input) => {
        values[input.name] = input.name === "day_of_week" ? Number(input.value) : input.value;
      });
      return values;
    });
    setStatus(managementStatus, "正在保存默认模板……", "pending");
    try {
      const season = currentSeasonData.season;
      await managedPost("updateScheduleTemplates", {
        season_id: season.season_id,
        season_version: season.season_version,
        templates
      }, `templates:${season.season_id}:${season.season_version}`);
      await loadSeason(season.season_id);
      setStatus(managementStatus, "默认训练模板已保存；尚未公开任何训练。", "ready");
    } catch (error) {
      if (!protectedError(error)) setStatus(managementStatus, messageForError(error), "error");
    }
  });

  weekForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!currentSeasonData) return;
    const season = currentSeasonData.season;
    setStatus(managementStatus, "正在从模板生成私有周草稿……", "pending");
    try {
      await managedPost("updateTrainingWeek", {
        season_id: season.season_id,
        season_version: season.season_version,
        ...formObject(weekForm)
      }, `week:${season.season_id}:${(weekForm.elements.namedItem("week_start_date") as HTMLInputElement).value}`);
      await loadSeason(season.season_id);
      setStatus(managementStatus, "周草稿已生成，队员页面仍不可见。检查后再确认开放。", "ready");
    } catch (error) {
      if (!protectedError(error)) setStatus(managementStatus, messageForError(error), "error");
    }
  });

  additionalForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!currentSeasonData || !additionalWeek) return;
    const option = additionalWeek.selectedOptions[0];
    if (!option) return;
    const season = currentSeasonData.season;
    setStatus(managementStatus, "正在保存私有加场草稿……", "pending");
    try {
      await managedPost("createPractice", {
        season_id: season.season_id,
        week_id: option.value,
        week_version: Number(option.dataset.weekVersion),
        ...formObject(additionalForm)
      }, `additional:${season.season_id}:${option.value}`);
      additionalForm.reset();
      await loadSeason(season.season_id);
      setStatus(managementStatus, "加场草稿已保存，尚未公开。请在对应周中单独发布。", "ready");
    } catch (error) {
      if (!protectedError(error)) setStatus(managementStatus, messageForError(error), "error");
    }
  });

  writeButton?.addEventListener("click", async () => {
    if (!writeButton) return;
    writeButton.disabled = true;
    setStatus(writeStatus, "正在验证受保护写入……", "pending");
    try {
      const response = await managedPost("coachConnectivityWrite", {}, "p0-connectivity");
      setStatus(writeStatus, `写入成功：${response.data.write_id}`, "ready");
    } catch (error) {
      if (!protectedError(error)) setStatus(writeStatus, messageForError(error), "error");
    } finally {
      writeButton.disabled = false;
    }
  });

  async function restoreSession() {
    if (!client) return showLogin("等待配置 Apps Script Web App 地址后即可登录。", "pending");
    const stored = loadCoachSession();
    if (!stored) return showLogin();
    sessionToken = stored.token;
    try {
      if (loginPanel) loginPanel.hidden = true;
      if (workspace) workspace.hidden = false;
      await refreshBootstrap();
    } catch (error) {
      clearCoachSession();
      showLogin(messageForError(error));
    }
  }

  restoreSession();
</script>
