---
import logoUrl from "../../assets/team-logo-placeholder.svg";
import "../styles/app.css";

const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const appPath = `${basePath}dragon-boat-training/`;
const coachPath = `${appPath}coach/`;
const apiUrl = import.meta.env.PUBLIC_DRAGON_BOAT_API_URL
  || "https://script.google.com/macros/s/AKfycbw4c8mBbop9Qnq29nYQ_AtLembq1OHKt_nRjIv3EE9kw0DliTVM0lMY6svr8X0gcQW8/exec";
---

<div class="dragon-boat-app" data-dragon-boat-app data-api-url={apiUrl}>
  <header class="dragon-boat-header dragon-boat-shell">
    <a class="dragon-boat-brand" href={appPath} aria-label="Dragon Boat Training 首页">
      <img src={logoUrl.src} alt="队伍 Logo 占位图" width="96" height="96" />
      <span class="dragon-boat-brand-copy">
        <span>Dragon Boat Training</span>
        <small>Team training portal</small>
      </span>
    </a>

    <nav class="dragon-boat-nav" aria-label="训练系统导航">
      <a href={appPath} aria-current="page">本季训练</a>
      <button type="button" disabled title="将在后续阶段实现">过往赛季</button>
      <a href={coachPath}>Coach Mode</a>
    </nav>
  </header>

  <main class="dragon-boat-main dragon-boat-shell">
    <p class="dragon-boat-kicker">P0 连接验证</p>
    <h1>训练系统基础连接</h1>
    <p class="dragon-boat-lede">
      当前页面只验证 GitHub Pages 与 Apps Script 的版本化连接。赛季、报名和管理员功能会按 Epic 顺序逐段接入。
    </p>

    <section class="dragon-boat-status-card" aria-labelledby="service-status-title" aria-live="polite">
      <div class="dragon-boat-status-heading">
        <h2 id="service-status-title">后端服务</h2>
        <span class="dragon-boat-status-badge" data-service-badge data-state="pending">正在检查</span>
      </div>
      <p class="dragon-boat-status-message" data-service-message>正在读取部署配置……</p>
      <p class="dragon-boat-status-detail" data-service-detail hidden></p>
    </section>

    <p class="dragon-boat-note">
      这个状态页不读取 Google Form、队员名单或训练资料，也不会写入业务数据。
    </p>
  </main>
</div>

<script>
  import { DragonBoatApiClient, DragonBoatApiError } from "../lib/api-client.js";

  const app = document.querySelector<HTMLElement>("[data-dragon-boat-app]");
  const badge = app?.querySelector<HTMLSpanElement>("[data-service-badge]");
  const message = app?.querySelector<HTMLParagraphElement>("[data-service-message]");
  const detail = app?.querySelector<HTMLParagraphElement>("[data-service-detail]");

  function showStatus(state: string, label: string, text: string, technicalDetail = "") {
    if (!badge || !message || !detail) return;
    badge.dataset.state = state;
    badge.textContent = label;
    message.textContent = text;
    detail.textContent = technicalDetail;
    detail.hidden = !technicalDetail;
  }

  async function checkService() {
    const apiUrl = app?.getAttribute("data-api-url")?.trim();
    if (!apiUrl) {
      showStatus(
        "pending",
        "尚未配置",
        "本地页面已经就绪，等待配置测试 Apps Script Web App 地址。",
        "PUBLIC_DRAGON_BOAT_API_URL is not set"
      );
      return;
    }

    try {
      const client = new DragonBoatApiClient({ baseUrl: apiUrl });
      const response = await client.get("health");
      const checkedAt = new Date(response.meta.server_time).toLocaleString();
      showStatus(
        "ready",
        "连接正常",
        "网站已收到 Apps Script 的有效响应。",
        `service ${response.data.service_version} · contract ${response.meta.contract_version} · ${checkedAt}`
      );
    } catch (error) {
      const code = error instanceof DragonBoatApiError ? error.code : "UNKNOWN_ERROR";
      showStatus("error", "连接失败", "暂时无法连接训练服务，请稍后重试。", code);
    }
  }

  checkService();
</script>
